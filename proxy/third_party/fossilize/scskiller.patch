+	bool set = false;
+	vector<string> extensions;
+	vector<pair<uint32_t, string>> features;  // a feature struct's sType and its VkBool32 members as '0'/'1'
+};
+
+static vector<string> words(const string &s)
+{
+	vector<string> w;
+	for (size_t i = 0; i < s.size();)
+	{
+		size_t j = s.find(' ', i);
+		if (j == string::npos)
+			j = s.size();
+		if (j > i)
+			w.push_back(s.substr(i, j - i));
+		i = j + 1;
+	}
+	return w;
+}
+
+static GameDevice game_device()
+{
+	GameDevice d;
+	const char *env = getenv("SCSKILLER_REPLAY_DEVICE");
+	if (!env || !*env)
+		return d;
+	const string s = env;
+	const size_t a = s.find(','), b = a == string::npos ? a : s.find(',', a + 1);
+	if (b == string::npos)
+	{
+		LOGW("SCSKILLER_REPLAY_DEVICE isn't a #vkdevice line, the replayer's own device is used.\n");
+		return d;
+	}
+	d.set = true;
+	d.extensions = words(s.substr(0, a));
+	for (auto &f : words(s.substr(b + 1)))
+	{
+		const size_t colon = f.find(':');
+		const string bits = colon == string::npos ? "" : f.substr(colon + 1);
+		// "?": a struct the recorder couldn't read, which the device then goes without
+		if (bits.empty() || bits.size() > 512 || bits.find_first_not_of("01") != string::npos)
+			LOGW("The game's feature struct %s can't be rebuilt, left out.\n", f.c_str());
+		else
+			d.features.emplace_back(uint32_t(strtoul(f.c_str(), nullptr, 10)), bits);
+	}
+	return d;
+}
