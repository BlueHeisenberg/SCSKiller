 using namespace Fossilize;
 using namespace std;
 
+// SCSKiller (fossilize_replay_windows.hpp, fossilize_replay_linux.hpp): a stop that never kills a process, and the list
+// of what was created
+static bool scsk_stopped();
+static void scsk_created(ResourceTag tag, Hash hash);
+static void scsk_failed(ResourceTag tag, Hash hash, VkResult result);
+static void scsk_unparsed(ResourceTag tag, Hash hash);
+static void scsk_invalid(ResourceTag tag, Hash hash);
+static void scsk_unsupported(ResourceTag tag, Hash hash);
+#ifdef SCSK_TEST_HOOKS
+static void scsk_test_fault(Hash hash);
+#endif
+
+// SCSKiller: the shader modules --spirv-val rejected and the ones the device doesn't support. A pipeline naming one gets
+// no create info and is listed as invalid, or else as unsupported.
+static mutex scsk_rejected_lock;
+static unordered_set<Hash> scsk_rejected, scsk_unsupported_modules;
+// by kind (a library is of its pipeline's kind): the pipelines listed invalid or unsupported, and the ones the driver
+// refused or that didn't parse, whose dependants are invalid
+static unordered_set<Hash> scsk_invalid_pipelines[RESOURCE_COUNT], scsk_unsupported_pipelines[RESOURCE_COUNT],
+	scsk_dead_pipelines[RESOURCE_COUNT];
+
+static void scsk_reject(Hash module)
+{
+	lock_guard<mutex> holder{scsk_rejected_lock};
+	scsk_rejected.insert(module);
+}
+
+static void scsk_reject_unsupported(Hash module)
+{
+	lock_guard<mutex> holder{scsk_rejected_lock};
+	scsk_unsupported_modules.insert(module);
+}
+
+static void scsk_dead(ResourceTag tag, Hash hash)
+{
+	lock_guard<mutex> holder{scsk_rejected_lock};
+	scsk_dead_pipelines[tag].insert(hash);
+}
+
+// a pipeline Fossilize leaves out before creating it, listed once
+static void scsk_skip(ResourceTag tag, Hash hash, bool unsupported)
+{
+	{
+		lock_guard<mutex> holder{scsk_rejected_lock};
+		if (scsk_invalid_pipelines[tag].count(hash) || scsk_unsupported_pipelines[tag].count(hash))
+			return;
+		(unsupported ? scsk_unsupported_pipelines : scsk_invalid_pipelines)[tag].insert(hash);
+	}
+	if (unsupported)
+		scsk_unsupported(tag, hash);
+	else
+		scsk_invalid(tag, hash);
+}
+
+// before resolve_shader_modules: the stages still hold their modules' hashes
+static void scsk_check_stages(ResourceTag tag, Hash hash, const VkPipelineShaderStageCreateInfo *stages, uint32_t count)
+{
+	bool rejected = false, unsupported = false;
+	{
+		lock_guard<mutex> holder{scsk_rejected_lock};
+		for (uint32_t i = 0; i < count && !rejected; i++)
+		{
+			rejected = scsk_rejected.count((Hash) stages[i].module) != 0;
+			unsupported = unsupported || scsk_unsupported_modules.count((Hash) stages[i].module) != 0;
+		}
+	}
+	if (rejected || unsupported)
+		scsk_skip(tag, hash, !rejected);
+}
+
+// the pipelines scskiller_warm left out of this pass as faulty (SCSKILLER_REPLAY_FAULTY: "<tag> <hash>" lines)
+static bool scsk_faulty(ResourceTag tag, Hash hash)
+{
+	static const vector<unordered_set<Hash>> faulty = [] {
+		vector<unordered_set<Hash>> s(RESOURCE_COUNT);
+		const char *path = getenv("SCSKILLER_REPLAY_FAULTY");
+		if (FILE *f = path ? fopen(path, "r") : nullptr)
+		{
+			unsigned t;
+			unsigned long long h;
+			while (fscanf(f, "%u %llx", &t, &h) == 2)
+				if (t < RESOURCE_COUNT)
+					s[t].insert(Hash(h));
+			fclose(f);
+		}
+		return s;
+	}();
+	return faulty[tag].count(hash) != 0;
+}
+
+// before resolve_pipelines: a pipeline whose library wasn't created is invalid when that library is invalid, refused,
+// unparsable or not in the archive, and unsupported when it is unsupported. Else a fault left it out: skipped as it is.
+// settled: the libraries queued for creation are done (their handles can be read), else only missing ones count.
+static void scsk_check_libraries(ResourceTag tag, Hash hash, const VkPipelineLibraryCreateInfoKHR *library,
+                                 const unordered_map<Hash, VkPipeline> &pipelines, DatabaseInterface *db, bool settled)
+{
+	bool invalid = false, unsupported = false;
+	for (uint32_t i = 0; library && i < library->libraryCount && !invalid; i++)
+	{
+		Hash lib = (Hash) library->pLibraries[i];
+		auto itr = pipelines.find(lib);
+		if ((itr != pipelines.end() && (!settled || itr->second != VK_NULL_HANDLE)) || scsk_faulty(tag, lib))
+			continue;
+		{
+			lock_guard<mutex> holder{scsk_rejected_lock};
+			invalid = scsk_invalid_pipelines[tag].count(lib) != 0 || scsk_dead_pipelines[tag].count(lib) != 0;
+			unsupported = unsupported || scsk_unsupported_pipelines[tag].count(lib) != 0;
+		}
+		invalid = invalid || (itr == pipelines.end() && db && !db->has_entry(tag, lib));
+	}
+	if (invalid || unsupported)
+		scsk_skip(tag, hash, !invalid);
+}
