 #include "fossilize_external_replayer.hpp"
 #include <inttypes.h>
 
+// SCSKiller: SCSKILLER_REPLAY_STOP names an event: once it is set no pipeline is created any more, and the replay ends
+// as a complete one does (devices destroyed, exit 0), never killed. SCSKILLER_REPLAY_CREATED names a folder where each
+// process appends what it created to created.<pid>.txt, one "<tag> <hash>" line a pipeline, written as it is created,
+// what the driver refused to create to failed.<pid>.txt, what didn't parse to unparsed.<pid>.txt, what names a module
+// that failed SPIR-V validation to invalid.<pid>.txt, and what the device's features don't support to
+// unsupported.<pid>.txt. The master runs one worker process with all the threads: every process under one exe name
+// writes the same NVIDIA cache file, and only part of what several write survives.
+static HANDLE scsk_stop_event()
+{
+	wchar_t name[256];
+	DWORD n = GetEnvironmentVariableW(L"SCSKILLER_REPLAY_STOP", name, 256);
+	return n && n < 256 ? OpenEventW(SYNCHRONIZE, FALSE, name) : nullptr;
+}
+
+// SCSKiller: a refusal with VK_ERROR_DEVICE_LOST goes to lost.<pid>.txt, and nothing more is created, as on a stop
+static std::atomic<bool> scsk_lost;
+
+static bool scsk_stopped()
+{
+	static HANDLE stop = scsk_stop_event();
+	return scsk_lost.load(std::memory_order_relaxed) || (stop && WaitForSingleObject(stop, 0) == WAIT_OBJECT_0);
+}
+
+static FILE *scsk_list_file(const wchar_t *what)
+{
+	wchar_t dir[MAX_PATH];
+	DWORD n = GetEnvironmentVariableW(L"SCSKILLER_REPLAY_CREATED", dir, MAX_PATH);
+	if (!n || n >= MAX_PATH)
+		return nullptr;
+	wchar_t path[MAX_PATH + 32];
+	swprintf(path, MAX_PATH + 32, L"%ls\\%ls.%lu.txt", dir, what, GetCurrentProcessId());
+	return _wfopen(path, L"ab");
+}
+
+static void scsk_list(FILE *file, std::mutex &lock, ResourceTag tag, Hash hash)
+{
+	if (!file)
+		return;
+	std::lock_guard<std::mutex> holder{lock};
+	fprintf(file, "%u %016" PRIx64 "\n", unsigned(tag), hash);
+	fflush(file);
+}
+
+static void scsk_created(ResourceTag tag, Hash hash)
+{
+	static std::mutex lock;
+	static FILE *file = scsk_list_file(L"created");
+	scsk_list(file, lock, tag, hash);
+}
+
+static void scsk_failed(ResourceTag tag, Hash hash, VkResult result)
+{
+	static std::mutex lock, lost_lock;
+	static FILE *file = scsk_list_file(L"failed");
+	if (result != VK_ERROR_DEVICE_LOST)
+		return scsk_list(file, lock, tag, hash);
+	static FILE *lost = scsk_list_file(L"lost");
+	scsk_list(lost, lost_lock, tag, hash);
+	scsk_lost.store(true, std::memory_order_relaxed);
+}
+
+static void scsk_unparsed(ResourceTag tag, Hash hash)
+{
+	static std::mutex lock;
+	static FILE *file = scsk_list_file(L"unparsed");
+	scsk_list(file, lock, tag, hash);
+}
+
+static void scsk_invalid(ResourceTag tag, Hash hash)
+{
+	static std::mutex lock;
+	static FILE *file = scsk_list_file(L"invalid");
+	scsk_list(file, lock, tag, hash);
+}
+
+static void scsk_unsupported(ResourceTag tag, Hash hash)
+{
+	static std::mutex lock;
+	static FILE *file = scsk_list_file(L"unsupported");
+	scsk_list(file, lock, tag, hash);
+}
+
+#ifdef SCSK_TEST_HOOKS
+// SCSKILLER_REPLAY_CRASH / SCSKILLER_REPLAY_HANG=<16 hex>: the create of that pipeline faults / never returns, in
+// every process that reaches it. SCSKILLER_REPLAY_WAIT: never returns only in the first process that reaches it, the
+// one that creates the file SCSKILLER_REPLAY_WAIT_ONCE names
+static bool scsk_test_is(const char *var, Hash hash)
+{
+	char want[32];
+	DWORD n = GetEnvironmentVariableA(var, want, sizeof(want));
+	return n && n < sizeof(want) && strtoull(want, nullptr, 16) == hash;
+}
+
+static void scsk_test_fault(Hash hash)
+{
+	if (scsk_test_is("SCSKILLER_REPLAY_CRASH", hash))
+		*(volatile int *)nullptr = 0;
+	if (scsk_test_is("SCSKILLER_REPLAY_HANG", hash))
+		Sleep(INFINITE);
+	char once[MAX_PATH];
+	DWORD n = GetEnvironmentVariableA("SCSKILLER_REPLAY_WAIT_ONCE", once, sizeof(once));
+	if (scsk_test_is("SCSKILLER_REPLAY_WAIT", hash) && n && n < sizeof(once))
+	{
+		HANDLE f = CreateFileA(once, GENERIC_WRITE, 0, nullptr, CREATE_NEW, 0, nullptr);
+		if (f != INVALID_HANDLE_VALUE)
+			CloseHandle(f), Sleep(INFINITE);
+	}
+}
+#endif
