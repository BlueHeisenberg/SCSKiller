+// ("<extensions>,<queues>,<features>", proxy/scskiller_layer.hpp). Set, the device is created with exactly those extensions
+// and feature bits: a driver that keys its pipeline cache on the enabled device (AMD) reaches the game's entries only so.
+struct GameDevice
