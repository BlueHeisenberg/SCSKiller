<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:SCSKiller.Ui"
             xmlns:c="using:SCSKiller.Ui.Controls"
             xmlns:m="using:SCSKiller.Ui.Models"
             x:Class="SCSKiller.Ui.Pages.QueuePage"
             x:DataType="m:QueueVm">

    <UserControl.Styles>
        <!-- row buttons are borderless, and stay so when disabled (first or last row) -->
        <Style Selector="Button.RowButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.RowButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <!-- this font draws these glyphs smaller: 18 px for WinUI's 14 -->
        <Style Selector="Button.RowButton TextBlock.Icon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- the waiting games: WinUI's ListView items, a backplate inset 4,2 and the selection's pill -->
        <Style Selector="ListBox#WaitingList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox#WaitingList > ListBoxItem">
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="Backplate" Margin="4,2" CornerRadius="4" />
                        <Border Name="Pill" Width="3" Height="16" CornerRadius="1.5" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" IsVisible="False" />
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" Background="Transparent"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox#WaitingList > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox#WaitingList > ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox#WaitingList > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox#WaitingList > ListBoxItem:pointerover /template/ Border#Backplate">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox#WaitingList > ListBoxItem:pressed /template/ Border#Backplate">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>
        <Style Selector="ListBox#WaitingList > ListBoxItem:selected /template/ Border#Backplate">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox#WaitingList > ListBoxItem:selected:pointerover /template/ Border#Backplate">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>
        <Style Selector="ListBox#WaitingList > ListBoxItem:selected:pressed /template/ Border#Backplate">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox#WaitingList > ListBoxItem:selected /template/ Border#Pill">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Border.Number">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.Tile">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.Tile > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <!-- Every row uses the same columns as the header: handle, number, icon, game, time, cache, actions. -->
    <ScrollViewer x:Name="Scroller">
        <StackPanel Margin="36,28,36,28" Spacing="20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Compile queue" Classes="Title" />
                    <TextBlock Text="{Binding Summary}" Classes="Secondary" />
                    <TextBlock Text="{Binding PlanChecks}" IsVisible="{Binding HasPlanChecks}" Classes="Caption"
                               ToolTip.Tip="After an update SCSKiller rebuilds the plans of compiled games in the background, without compiling. A game with more to compile shows it in the Library." />
                    <TextBlock Text="Compiles run outside the game, under the game's name. Keep the game closed while it runs."
                               Classes="Caption" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                    <Button Classes="accent" Click="OnStart" AutomationProperties.Name="Compile queue" IsVisible="{Binding Idle}" IsEnabled="{Binding CanStart}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Bolt}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Compile queue" />
                        </StackPanel>
                    </Button>
                    <Button Content="{Binding PauseText}" Click="OnPause" IsVisible="{Binding HasCurrent}" />
                    <Button Content="Stop" Click="OnStop" IsVisible="{Binding CanStop}"
                            ToolTip.Tip="Finishes the compiles in flight, then stops. Add the game again to continue where it stopped." />
                </StackPanel>
            </Grid>

            <c:InfoBar Severity="Warning" IsClosable="False" IsVisible="{Binding RuntimeWarn}" Message="{Binding RuntimeWarnText}" />
            <c:InfoBar Severity="Warning" IsClosable="False" IsVisible="{Binding CacheWarn}" Message="{Binding CacheWarnText}">
                <c:InfoBar.ActionButton>
                    <HyperlinkButton Content="Raise the limit" Click="OnSettings" IsVisible="{Binding CanRaiseLimit}" />
                </c:InfoBar.ActionButton>
            </c:InfoBar>

            <Border Classes="Card" Padding="0">
                <StackPanel>
                    <Grid Height="40" Margin="16,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition MinWidth="160" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Text="Game (in run order)" Classes="Caption" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Time" Classes="Caption" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Cache" Classes="Caption" TextAlignment="Right" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="{Binding CanClear}">
                            <!-- tooltip on a hit-testable wrapper: a disabled button shows none -->
                            <Panel Background="Transparent" ToolTip.Tip="Ctrl+click or Shift+click to select several games">
                                <HyperlinkButton x:Name="RemoveSelected" Content="Remove selected" FontSize="12" IsEnabled="False" Click="OnRemoveSelected" />
                            </Panel>
                            <HyperlinkButton Content="Clear queue" FontSize="12" Click="OnClearQueue" ToolTip.Tip="Removes every game but the one compiling" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />

                    <StackPanel Margin="20,32" Spacing="6" HorizontalAlignment="Center" IsVisible="{Binding Empty}">
                        <TextBlock Text="Add games from the Library" Classes="Section" HorizontalAlignment="Center" />
                        <TextBlock Text="Press Add to queue on a game, then Compile queue." Classes="Secondary" HorizontalAlignment="Center" />
                        <HyperlinkButton Content="Open the Library" Click="OnLibrary" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- The running item: not draggable, always first. -->
                    <Grid Margin="16,10,16,10" ColumnSpacing="12" RowSpacing="6" RowDefinitions="*,Auto" IsVisible="{Binding HasCurrent}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition MinWidth="160" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Classes="Number" Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Panel Grid.Column="2" Width="32" Height="32">
                            <Border Classes="Tile" Background="{Binding Current.Tile, Converter={x:Static ui:Converters.ArgbBrush}}" IsVisible="{Binding Current.NoIcon}">
                                <TextBlock Text="{Binding Current.Initials}" />
                            </Border>
                            <Image Source="{Binding Current.Icon, Converter={x:Static ui:Converters.Image}}" />
                        </Panel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Current.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentDetail}" Classes="Caption" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="{Binding Current.Time}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{Binding Current.Cache}" TextAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="6" HorizontalAlignment="Right" Classes="RowButton" Padding="0" Click="OnRemoveCurrent"
                                AutomationProperties.Name="{Binding Current.RemoveLabel}" ToolTip.Tip="Stop and remove">
                            <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Dismiss}" />
                        </Button>
                        <ProgressBar Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}"
                                     AutomationProperties.Name="Compile progress" />
                    </Grid>

                    <Panel>
                        <ListBox x:Name="WaitingList" ItemsSource="{Binding Waiting}" SelectionMode="Multiple" SelectionChanged="OnSelection"
                                 AutomationProperties.Name="Waiting games">
                            <!-- every row realized: a drag measures them all -->
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:QueueRow">
                                    <Grid ColumnSpacing="12" MinHeight="56" AutomationProperties.Name="{Binding StringFormat='{}{0}'}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition MinWidth="160" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="320" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Reorder}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" ToolTip.Tip="Drag to reorder" />
                                        <Border Grid.Column="1" Classes="Number" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding Number}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Panel Grid.Column="2" Width="32" Height="32">
                                            <Border Classes="Tile" Background="{Binding Tile, Converter={x:Static ui:Converters.ArgbBrush}}" IsVisible="{Binding NoIcon}">
                                                <TextBlock Text="{Binding Initials}" />
                                            </Border>
                                            <Image Source="{Binding Icon, Converter={x:Static ui:Converters.Image}}" />
                                        </Panel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" Margin="0,6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Note}" Classes="Caption" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="3" ToolTip.Tip="{Binding Note}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="{Binding Time}" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding Cache}" TextAlignment="Right" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                                            <Button Content="Move to top" Classes="RowButton" FontSize="13" IsEnabled="{Binding CanUp}" Click="OnTop"
                                                    AutomationProperties.Name="{Binding TopLabel}" />
                                            <Button Content="Move to bottom" Classes="RowButton" FontSize="13" IsEnabled="{Binding CanDown}" Click="OnBottom"
                                                    AutomationProperties.Name="{Binding BottomLabel}" />
                                            <Button Classes="RowButton" Padding="0" IsEnabled="{Binding CanUp}" Click="OnUp"
                                                    AutomationProperties.Name="{Binding UpLabel}" ToolTip.Tip="Move up">
                                                <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.ChevronUp}" />
                                            </Button>
                                            <Button Classes="RowButton" Padding="0" IsEnabled="{Binding CanDown}" Click="OnDown"
                                                    AutomationProperties.Name="{Binding DownLabel}" ToolTip.Tip="Move down">
                                                <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.ChevronDown}" />
                                            </Button>
                                            <Button Classes="RowButton" Padding="0" Click="OnRemove"
                                                    AutomationProperties.Name="{Binding RemoveLabel}" ToolTip.Tip="Remove">
                                                <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Dismiss}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- where a drag drops its rows -->
                        <Border x:Name="DropLine" Height="2" Margin="16,0" VerticalAlignment="Top" CornerRadius="1" IsHitTestVisible="False" IsVisible="False"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Panel>

                    <StackPanel IsVisible="{Binding HasFinished}" Margin="0,0,0,8">
                        <Rectangle Height="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Grid Margin="16,6,16,0">
                            <TextBlock Text="Finished" Classes="Caption" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Clear finished" HorizontalAlignment="Right" FontSize="12" Click="OnClearFinished" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Finished}" AutomationProperties.Name="Finished games">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:QueueRow">
                                    <Button Classes="Row" Click="OnGameClick" AutomationProperties.Name="{Binding StringFormat='{}{0}'}">
                                        <Grid ColumnSpacing="12" MinHeight="48">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition MinWidth="160" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="320" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Classes="Icon" Text="{Binding Stage, Converter={x:Static ui:Converters.StageGlyph}}" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Panel Grid.Column="2" Width="32" Height="32" Opacity="0.55">
                                                <Border Classes="Tile" Background="{Binding Tile, Converter={x:Static ui:Converters.ArgbBrush}}" IsVisible="{Binding NoIcon}">
                                                    <TextBlock Text="{Binding Initials}" />
                                                </Border>
                                                <Image Source="{Binding Icon, Converter={x:Static ui:Converters.Image}}" />
                                            </Panel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Note}" Classes="Caption" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Note}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding Time}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding Cache}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                            <Button Grid.Column="6" HorizontalAlignment="Right" Classes="RowButton" Padding="0" Click="OnRemove"
                                                    AutomationProperties.Name="{Binding RemoveLabel}" ToolTip.Tip="Remove">
                                                <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Dismiss}" />
                                            </Button>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Expander Header="{Binding CpuSummary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="Compile threads" />
                        <TextBlock Text="{Binding ThreadsText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider Minimum="1" Maximum="{Binding MaxThreads, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Threads}"
                            AutomationProperties.Name="Compile threads" />
                    <StackPanel>
                        <TextBlock Text="Priority" Margin="0,0,0,8" />
                        <RadioButton GroupName="Priority" Content="Below normal: fastest, the PC stays usable"
                                     IsChecked="{Binding Priority, Converter={x:Static ui:Converters.Index}, ConverterParameter=0}" />
                        <RadioButton GroupName="Priority" Content="Idle only: runs when nothing else needs the CPU"
                                     IsChecked="{Binding Priority, Converter={x:Static ui:Converters.Index}, ConverterParameter=1}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
