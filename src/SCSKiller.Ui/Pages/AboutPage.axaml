<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:SCSKiller.Ui"
             xmlns:loc="using:SCSKiller.Ui"
             xmlns:c="using:SCSKiller.Ui.Controls"
             xmlns:m="using:SCSKiller.Ui.Models"
             xmlns:app="using:SCSKiller.Core.App"
             x:Class="SCSKiller.Ui.Pages.AboutPage"
             x:DataType="m:AboutVm">

    <UserControl.Styles>
        <!-- WinUI's selectable text keeps its TextBlock style -->
        <Style Selector="SelectableTextBlock.Secondary">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.Caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- a component's name on the left, its licence on the right -->
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- the header is a Grid: without a name it reads as its type -->
        <Style Selector="Expander.Notice /template/ ToggleButton#ExpanderHeader" x:DataType="m:Notice">
            <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
        </Style>
        <Style Selector="HyperlinkButton.Link">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Margin="36,28,36,28" Spacing="16">
            <TextBlock Text="{loc:Loc About_Title}" Classes="Title" />

            <Border Classes="Card" Padding="20">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Bolt}" FontSize="36" VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="SCSKiller" Classes="Section" FontSize="20" />
                        <TextBlock Text="{loc:Loc Title_Subtitle}" Classes="Secondary" />
                        <SelectableTextBlock Text="{Binding Version}" Classes="Caption" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" IsVisible="{Binding ShowsCheck}">
                            <Button Content="{loc:Loc About_CheckForUpdates}" Click="OnCheckForUpdates" IsEnabled="{Binding CanCheck}" />
                            <TextBlock Text="{Binding UpdateNote}" Classes="Caption" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdatesFrom}" Classes="Caption" Margin="0,4,0,0" TextWrapping="Wrap" IsVisible="{Binding UpdatedElsewhere}" />
                        <CheckBox IsChecked="{Binding InstallUpdatesAutomatically, Mode=TwoWay}" IsVisible="{Binding ShowsAutoInstall}"
                                  AutomationProperties.Name="{loc:Loc About_InstallUpdatesAutomatically}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc About_InstallUpdatesAutomatically}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc About_UpdateNote}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <c:InfoBar IsVisible="{Binding HasUpdateProblem}" Message="{Binding UpdateProblem}" Severity="Warning" IsClosable="False" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" IsVisible="{Binding ShowsSource}">
                            <Button Content="{loc:Loc About_DownloadSource}" Click="OnSource" IsEnabled="{Binding SourceIdle}" />
                            <SelectableTextBlock Text="{Binding SourceStatus}" Classes="Caption" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{loc:Loc About_Description}" />
                        <TextBlock Margin="0,8,0,0" Classes="Secondary" TextWrapping="Wrap">
                            <Run Text="{loc:Loc About_License}" FontWeight="SemiBold" /><Run Text=" GPL-3.0-or-later, with an additional permission for Oodle, the Windows App SDK and graphics driver libraries (LICENSE-EXCEPTION.txt)" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <HyperlinkButton Content="{loc:Loc About_WhatsNew}" Classes="Link" Click="OnWhatsNew" />
                            <HyperlinkButton Content="{loc:Loc About_Website}" Classes="Link" NavigateUri="https://scskiller.com" />
                            <HyperlinkButton Content="{loc:Loc About_SourceCode}" Classes="Link" NavigateUri="https://github.com/BlueHeisenberg/SCSKiller" />
                            <HyperlinkButton Content="{loc:Loc About_SupportPatreon}" Classes="Link" NavigateUri="https://www.patreon.com/SCSKiller" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Loc About_ReportsSent}" Classes="Section" />
                <TextBlock Text="{loc:Loc About_ReportsNote}" Classes="Secondary" TextWrapping="Wrap" IsVisible="{Binding NoProblems}" />
                <ItemsControl ItemsSource="{Binding Problems}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:SentProblem">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <SelectableTextBlock Text="{Binding Id}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="Secondary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Loc About_DisclaimerTitle}" Classes="Section" />
                <TextBlock Text="{loc:Loc About_DisclaimerText}"
                           Classes="Secondary" TextWrapping="Wrap" />
            </StackPanel>

            <Expander x:Name="TrademarksBox" Header="{loc:Loc About_Trademarks}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <!-- FontSize first: the app sets every TextBlock's line height when its font size changes -->
                <SelectableTextBlock Text="{Binding Trademarks}" Classes="Secondary" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
            </Expander>

            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Loc About_ThirdParty}" Classes="Section" />
                <TextBlock Text="{loc:Loc About_ThirdPartyNote}"
                           Classes="Secondary" TextWrapping="Wrap" />
                <ItemsControl x:Name="Components" ItemsSource="{Binding Components}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:Notice">
                            <Expander Classes="Notice" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,8">
                                        <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding LicenceName}" Classes="Caption" VerticalAlignment="Center" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Spacing="8">
                                    <SelectableTextBlock Text="{Binding Detail}" Classes="Secondary" TextWrapping="Wrap" />
                                    <SelectableTextBlock Text="{Binding Project}" Classes="Caption" />
                                    <SelectableTextBlock Text="{Binding Note}" Classes="Secondary" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                                    <SelectableTextBlock Text="{Binding Body}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
