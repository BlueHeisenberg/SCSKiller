<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:SCSKiller.Ui"
             
             xmlns:ui="using:SCSKiller.Ui"
             xmlns:c="using:SCSKiller.Ui.Controls"
             xmlns:m="using:SCSKiller.Ui.Models"
             x:Class="SCSKiller.Ui.Pages.SettingsPage"
             x:DataType="m:SettingsVm">

    <UserControl.Styles>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="{x:Null}" />
            <Setter Property="OffContent" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Rectangle.Divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <!-- WinUI's RadioButtons with two-line choices: 15 px more per row, 6 above and 8 below the group (measured on its shots) -->
        <Style Selector="StackPanel.Radios">
            <Setter Property="Margin" Value="0,6,0,8" />
        </Style>
        <Style Selector="StackPanel.Radios > RadioButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,7,0,8" />
        </Style>
        <!-- WinUI's ComboBox Header -->
        <Style Selector="TextBlock.Header">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Margin="36,28,36,28" Spacing="16">
            <TextBlock Text="{loc:T Nav_Settings}" Classes="Title" />

            <Border Classes="Card" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding CacheTitle}" Classes="Section" />
                        <TextBlock Text="{Binding CacheIntro}" Classes="Secondary" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Cache_CurrentLimit}" Classes="Caption" />
                            <TextBlock Text="{Binding CurrentLimit}" Classes="Section" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{loc:T Cache_UsedNow}" Classes="Caption" />
                            <TextBlock Text="{Binding Used}" Classes="Section" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{Binding FreeLabel}" Classes="Caption" />
                            <TextBlock Text="{Binding Free}" Classes="Section" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="14" IsVisible="{Binding Configurable, Mode=OneTime}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="NewLimitLabel" Text="{loc:T Cache_NewLimit}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static m:SettingsVm.SizeLabels}" MinWidth="220"
                                      SelectedIndex="{Binding SizeIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding #NewLimitLabel}" />
                            <Button Grid.Column="3" Classes="accent" Click="OnApply" AutomationProperties.Name="{loc:T Cache_ApplyAdmin}" IsEnabled="{Binding CanApplyLimit}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Shield}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T Cache_ApplyAdmin}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <c:InfoBar IsVisible="{Binding HasApplyMessage}" Message="{Binding ApplyMessage}" Severity="{Binding ApplySeverity}" IsClosable="False" />
                        <TextBlock Text="{loc:T Cache_SwitchBackNote}" Classes="Caption" />
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding HasAmdUse}">
                        <TextBlock Text="{Binding AmdUse}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding AmdPercent}" AutomationProperties.Name="{loc:T Cache_AmdUse}" />
                    </StackPanel>
                    <c:InfoBar IsVisible="{Binding NotConfigurable, Mode=OneTime}" Severity="Informational" IsClosable="False" Message="{Binding NotConfigurableText}" />
                    <c:InfoBar IsVisible="{Binding HasAmdAlwaysOn}" Severity="Warning" IsClosable="False" Message="{Binding AmdAlwaysOn}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsAmd, Mode=OneTime}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Settings_KeepCachesAside}" Classes="BodyStrong" />
                            <TextBlock Text="{loc:T Settings_KeepAsideDesc}" Classes="Secondary" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" IsVisible="{Binding HasKept}">
                                <TextBlock Text="{Binding KeptSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="{loc:T Settings_Manage}" Click="OnManageKept" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepCachesAside, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_KeepCachesAside}" />
                    </Grid>
                    <StackPanel Spacing="8" IsVisible="{Binding ShowsShaderCleanup, Mode=OneTime}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{loc:T Settings_WindowsCleanup}" Classes="BodyStrong" />
                                <TextBlock Text="{loc:T Settings_StorageSense}" Classes="Secondary" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="OnShaderCleanup" VerticalAlignment="Center" AutomationProperties.Name="{Binding ShaderCleanupAction}" IsEnabled="{Binding CanApplyShaderCleanup}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Shield}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ShaderCleanupAction}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <c:InfoBar IsVisible="{Binding HasShaderCleanupMessage}" Message="{Binding ShaderCleanupMessage}" Severity="{Binding ShaderCleanupSeverity}" IsClosable="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <Border Classes="Card" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:T Settings_AfterDriverUpdate}" Classes="Section" />
                        <TextBlock Text="{loc:T Settings_DriverUpdateDesc}"
                                   Classes="Secondary" TextWrapping="Wrap" />
                        <StackPanel Classes="Radios" AutomationProperties.Name="{loc:T Settings_WhenToRebuild}" IsVisible="{Binding ShowsDriverModes, Mode=OneTime}">
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="{loc:T Settings_AskMe}"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=0}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_AskMe}" />
                                    <TextBlock Text="{x:Static m:SettingsVm.AskNote}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="{loc:T Settings_WhenIdle}"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=1}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_WhenIdle}" />
                                    <TextBlock Text="{x:Static m:SettingsVm.WhenIdleNote}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="{loc:T Settings_RightAway}"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=2}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_RightAway}" />
                                    <TextBlock Text="{loc:T Settings_RightAwayDesc}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="{loc:T Common_Off}"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=3}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Common_Off}" />
                                    <TextBlock Text="{loc:T Settings_RebuildYourself}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <TextBlock Text="{Binding DriverModesNote, Mode=OneTime}" IsVisible="{Binding HasDriverModesNote, Mode=OneTime}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastRebuilt}" Classes="Caption" IsVisible="{Binding HasLastRebuilt}" />
                        <Rectangle Classes="Divider" />
                        <TextBlock x:Name="NewShadersHeader" Text="{loc:T Settings_NewShadersTitle}" Classes="Section" />
                        <TextBlock Text="{loc:T Settings_NewShadersDesc}"
                                   Classes="Secondary" TextWrapping="Wrap" />
                        <StackPanel Classes="Radios" AutomationProperties.Name="{loc:T Settings_NewShadersTitle}">
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="{loc:T Common_Off}"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=0}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Common_Off}" />
                                    <TextBlock Text="{loc:T Settings_NewShadersOff}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="{loc:T Settings_NotifyMe}"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=1}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_NotifyMe}" />
                                    <TextBlock Text="{loc:T Settings_NewShadersSilentDesc}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="{loc:T Settings_NewShadersNotify}"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=2}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_NewShadersNotify}" />
                                    <TextBlock Text="{loc:T Settings_WhenIdleDesc}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="{loc:T Settings_NewShadersSilent}"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=3}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_NewShadersSilent}" />
                                    <TextBlock Text="{loc:T Settings_SilentDesc}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding NewShadersRightAway, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_NewShadersRightAway}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings_NewShadersRightAway}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:T Settings_NewGamesRightAwayDesc}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding CompileNewGames, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_CompileNewGames}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings_CompileNewGames}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:T Settings_CompileNewGamesDesc}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <Rectangle Classes="Divider" />
                        <CheckBox Content="{loc:T Settings_PauseWhileGaming}" IsChecked="{Binding PauseWhileGaming, Mode=TwoWay}" />
                        <Grid>
                            <TextBlock Text="{loc:T Settings_BackgroundThreads}" />
                            <TextBlock Text="{Binding BackgroundThreadsText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="1" Maximum="{Binding MaxThreads, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding BackgroundThreads, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_BackgroundThreads}" />
                        <StackPanel Spacing="12" IsVisible="{Binding ShowsAutoShader, Mode=OneTime}">
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="AutoBox" Content="{loc:T Settings_AutoShaderTitle}" IsChecked="{Binding AutoOn, Mode=TwoWay}" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T Detail_SystemUtilization}" Classes="Header" />
                                        <ComboBox ItemsSource="{x:Static m:SettingsVm.AutoLevels}" SelectedIndex="{Binding AutoLevelIndex, Mode=TwoWay}"
                                                  IsEnabled="{Binding #AutoBox.IsChecked}" MinWidth="140" AutomationProperties.Name="{loc:T Detail_SystemUtilization}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="OnApplyAuto" VerticalAlignment="Bottom" AutomationProperties.Name="{loc:T Cache_ApplyAdmin}" IsEnabled="{Binding CanApplyAuto}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Shield}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:T Cache_ApplyAdmin}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding AutoShaderText}" Classes="Caption" TextWrapping="Wrap" />
                                <c:InfoBar IsVisible="{Binding HasAutoMessage}" Message="{Binding AutoMessage}" Severity="{Binding AutoSeverity}" IsClosable="False" />
                            </StackPanel>
                            <c:InfoBar Severity="Informational" IsClosable="False" Title="{loc:T Settings_RecommendIt}"
                                       Message="{loc:T Settings_AutoShaderDesc}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">

                    <Border x:Name="PatreonCard" Classes="Card" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:T Settings_PatreonTitle}" Classes="Section" />
                            <!-- the account's part: its DataContext is the page's AccountVm -->
                            <StackPanel x:Name="AccountPart" x:DataType="m:AccountVm" Spacing="12">
                                <StackPanel Spacing="12" IsVisible="{Binding SignedOut}">
                                    <TextBlock Text="{loc:T Settings_PatreonDesc}"
                                               Classes="Secondary" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Classes="accent" Content="{loc:T Settings_SignInPatreon}" Click="OnSignIn" IsEnabled="{Binding Idle}" />
                                        <Button Content="{loc:T Common_Cancel}" Click="OnCancelSignIn" IsVisible="{Binding SigningIn}" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:T Settings_SignInBrowser}" Classes="Caption" TextWrapping="Wrap"
                                               IsVisible="{Binding SigningIn}" />
                                </StackPanel>
                                <StackPanel Spacing="12" IsVisible="{Binding SignedIn}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{loc:T Settings_SignedIn}" />
                                        <TextBlock Text="{Binding Benefits}" Classes="Caption" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="{loc:T Detail_RefreshStatus}" Click="OnRefreshAccount" IsEnabled="{Binding Idle}" />
                                        <Button Content="{loc:T Settings_SignOut}" Click="OnSignOut" IsEnabled="{Binding CanSignOut}" />
                                        <c:ProgressRing IsActive="{Binding Busy}" IsVisible="{Binding Busy}" Width="16" Height="16" />
                                    </StackPanel>
                                    <c:InfoBar IsVisible="{Binding OffersSharing}" Severity="Success" IsClosable="False"
                                               Title="{loc:T Settings_YouInPrompt}"
                                               Message="{loc:T Settings_SharedAnonNote}">
                                        <c:InfoBar.ActionButton>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                                <Button Classes="accent" Content="{loc:T Settings_ShareAnonymously}" Click="OnShare" />
                                                <Button Content="{loc:T Common_NotNow}" Click="OnNotNow" />
                                            </StackPanel>
                                        </c:InfoBar.ActionButton>
                                    </c:InfoBar>
                                </StackPanel>
                                <c:InfoBar IsVisible="{Binding HasProblem}" Message="{Binding Problem}" Severity="Warning" IsClosable="False" />
                                <StackPanel Spacing="8" IsVisible="{Binding ShowsUpdates}">
                                    <Rectangle Classes="Divider" />
                                    <StackPanel IsVisible="{Binding ShowsChannels}">
                                        <TextBlock Text="{loc:T Settings_UpdateChannel}" Classes="Header" />
                                        <ComboBox x:Name="ChannelBox" ItemsSource="{Binding ChannelLabels}" SelectedIndex="{Binding ChannelIndex, Mode=OneWay}" SelectionChanged="OnChannelPicked"
                                                  IsEnabled="{Binding CanPickChannel}" MinWidth="260" AutomationProperties.Name="{loc:T Settings_UpdateChannel}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ChannelNote}" Classes="Caption" TextWrapping="Wrap" />
                                    <Button Content="{loc:T Settings_BackToStable}" Click="OnBackToStable" IsEnabled="{Binding CanPickChannel}" IsVisible="{Binding OffersBackToStable}" />
                                    <c:InfoBar IsVisible="{Binding HasUpdateProblem}" Message="{Binding UpdateProblem}" Severity="Warning" IsClosable="False" />
                                </StackPanel>
                                <Rectangle Classes="Divider" />
                                <StackPanel Spacing="4">
                                    <CheckBox IsChecked="{Binding UseCommunityDb, Mode=TwoWay}" IsEnabled="{Binding HasDb}" AutomationProperties.Name="{loc:T Settings_DownloadShared}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{loc:T Settings_DownloadShared}" TextWrapping="Wrap" />
                                            <TextBlock Text="{loc:T Settings_UseSharedDesc}" Classes="Caption" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Text="{Binding DbNote}" IsVisible="{Binding HasDbNote}" Classes="Caption" TextWrapping="Wrap" Margin="28,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ShareDiagnostics, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_ShareDiagnostics}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_ShareDiagnostics}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:T Settings_DiagnosticsDesc}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ShareRecordings, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_ShareHashes}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_ShareHashes}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:T Settings_ShareDesc}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <HyperlinkButton Content="{loc:T Settings_WhatsShared}" NavigateUri="https://scskiller.com/privacy" Padding="0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Classes="Card" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:T Settings_QueueSpeed}" Classes="Section" />
                            <StackPanel Spacing="4" IsVisible="{Binding HasGpuChoices, Mode=OneTime}">
                                <TextBlock Text="{loc:T Settings_GpuToCompileFor}" Classes="Header" />
                                <ComboBox ItemsSource="{Binding GpuLabels, Mode=OneTime}" SelectedIndex="{Binding GpuIndex, Mode=TwoWay}"
                                          MinWidth="220" AutomationProperties.Name="{loc:T Settings_GpuToCompileFor}" />
                                <TextBlock Text="{loc:T Settings_GpuDesc}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ExperimentalIntel, Mode=TwoWay}" IsVisible="{Binding HasIntelGpu, Mode=OneTime}"
                                      AutomationProperties.Name="{loc:T Settings_ExperimentalIntel}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_ExperimentalIntel}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:T Settings_IntelNote}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <Grid>
                                <TextBlock Text="{loc:T Settings_CompileThreads}" />
                                <TextBlock Text="{Binding ThreadsText}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="1" Maximum="{Binding MaxThreads, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Threads, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_CompileThreads}" />
                            <TextBlock Text="{Binding PriorityNote}" Classes="Caption" />
                            <Grid>
                                <TextBlock Text="{loc:T Settings_MaxMemory}" />
                                <TextBlock Text="{Binding MaxCompileMemoryText}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="{Binding MaxCompileMemoryMax, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding MaxCompileMemory, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_MaxMemory0}" />
                            <TextBlock Text="{Binding MaxCompileMemoryNote, Mode=OneTime}" TextWrapping="Wrap" Classes="Caption" />
                            <Rectangle Classes="Divider" />
                            <CheckBox IsChecked="{Binding MaximumPlans, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_MaximumMode}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_MaximumMode}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:T Settings_MaximumModeDesc}"
                                               Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding CompileRayTracing, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_CompileRayTracing}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_CompileRayTracing}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:T Settings_RayTracingOffDesc}"
                                               Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Classes="Card" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:T Settings_General}" Classes="Section" />
                        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" IsVisible="{Binding ShowsStartAtSignIn, Mode=OneTime}"
                                  AutomationProperties.Name="{x:Static m:SettingsVm.StartText}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Static m:SettingsVm.StartText}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Static m:SettingsVm.StartNote}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding CloseQuits, Mode=TwoWay}" IsVisible="{Binding ShowsCloseQuits, Mode=OneTime}"
                                  AutomationProperties.Name="{loc:T Settings_CloseQuits}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings_CloseQuits}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CloseQuitsNote}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding BeforeAfter, Mode=TwoWay}" AutomationProperties.Name="{loc:T Detail_BeforeAfter}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Detail_BeforeAfter}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:T Detail_BeforeAfterDesc}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding ScanAtStart, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_ScanAtStart}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings_ScanAtStart}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ScanAtStartNote, Mode=OneTime}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding HddMode, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_HddMode}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings_HddMode}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:T Settings_HddDesc}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Spacing="2" Margin="28,0,0,0" IsVisible="{Binding ShowsHddDrives}">
                            <TextBlock Text="{loc:T Settings_HddDrives}" Classes="Caption" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding HddDrives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:HddDriveRow">
                                        <CheckBox Content="{Binding Drive}" IsChecked="{Binding On, Mode=TwoWay}" AutomationProperties.Name="{Binding Drive}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding ActiveCheck, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_ActiveCheck}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings_ActiveCheck}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:T Settings_ActiveCheckDesc}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings_Theme}" Classes="Header" />
                            <ComboBox ItemsSource="{Binding Themes, Mode=OneTime}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" MinWidth="220"
                                      AutomationProperties.Name="{loc:T Settings_Theme}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding LanguageLabel, Mode=OneTime}" Classes="Header" />
                            <ComboBox ItemsSource="{Binding Languages, Mode=OneTime}" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" MinWidth="220"
                                      AutomationProperties.Name="{Binding LanguageLabel, Mode=OneTime}" />
                            <TextBlock Text="{Binding RestartNote, Mode=OneTime}" Classes="Caption" IsVisible="{Binding LanguageRestarts}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Classes="Card" Padding="20">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings_RecordAllGames}" Classes="Section" />
                                <TextBlock Text="{Binding RecordAllGamesNote, Mode=OneTime}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding RecordAllGames, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_RecordAllGames}" />
                        </Grid>
                        <TextBlock Text="{Binding RecordingCount}" Classes="Caption" TextWrapping="Wrap" />
                        <StackPanel Spacing="4" IsVisible="{Binding ShowsRecordAntiCheatGames, Mode=OneTime}">
                            <CheckBox IsChecked="{Binding RecordAntiCheatGames, Mode=TwoWay}" AutomationProperties.Name="{loc:T Settings_AllowAntiCheatRecorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings_AllowAntiCheatRecorder}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:T Settings_AllowAntiCheatDesc}"
                                               Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <HyperlinkButton Content="{loc:T Common_Details}" Click="OnAntiCheatDetails" Padding="0" Margin="28,0,0,0" AutomationProperties.Name="{loc:T Settings_AntiCheatDetails}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding ShowsTraversal, Mode=OneTime}">
                            <Rectangle Classes="Divider" Margin="0,6" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock x:Name="TraversalLabel" Text="{loc:T Settings_TraversalTitle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static m:SettingsVm.TraversalChoices}" MinWidth="140"
                                          SelectedIndex="{Binding TraversalIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding #TraversalLabel}" />
                            </Grid>
                            <TextBlock Text="{Binding TraversalNote}" Classes="Caption" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TraversalWarning}" IsVisible="{Binding TraversalLowVram}" Foreground="{DynamicResource WarnBrush}" Classes="Caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <Rectangle Classes="Divider" Margin="0,6" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="RecordingLimitLabel" Text="{loc:T Settings_RecordingLimit}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static m:SettingsVm.RecordingLimitLabels}" MinWidth="140"
                                      SelectedIndex="{Binding RecordingLimitIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding #RecordingLimitLabel}" />
                        </Grid>
                        <TextBlock Text="{loc:T Settings_RecordingLimitDesc}"
                                   Classes="Caption" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RecordingSpace}" TextWrapping="Wrap" />
                        <Expander Header="{loc:T Cache_SpaceByGame}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="{Binding HasRecordings}">
                            <ItemsControl ItemsSource="{Binding Recordings}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:DetailRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Foreground="{DynamicResource WarnBrush}" Classes="Caption" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <StackPanel x:Name="RemoveRecordersPart" Spacing="8">
                            <Rectangle Classes="Divider" Margin="0,6" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{loc:T Settings_RemoveRecordersDesc}"
                                           Classes="Caption" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{loc:T Settings_RemoveRecorders}" Click="OnRemoveRecorders" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
