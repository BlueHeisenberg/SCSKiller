<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:SCSKiller.Ui"
             xmlns:loc="using:SCSKiller.Ui"
             xmlns:c="using:SCSKiller.Ui.Controls"
             xmlns:m="using:SCSKiller.Ui.Models"
             x:Class="SCSKiller.Ui.Pages.SettingsPage"
             x:DataType="m:SettingsVm">

    <UserControl.Styles>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="{x:Null}" />
            <Setter Property="OffContent" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Rectangle.Divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <!-- WinUI's RadioButtons with two-line choices: 15 px more per row, 6 above and 8 below the group (measured on its shots) -->
        <Style Selector="StackPanel.Radios">
            <Setter Property="Margin" Value="0,6,0,8" />
        </Style>
        <Style Selector="StackPanel.Radios > RadioButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,7,0,8" />
        </Style>
        <!-- WinUI's ComboBox Header -->
        <Style Selector="TextBlock.Header">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Margin="36,28,36,28" Spacing="16">
            <TextBlock Text="{loc:Loc Settings_Title}" Classes="Title" />

            <Border Classes="Card" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding CacheTitle}" Classes="Section" />
                        <TextBlock Text="{Binding CacheIntro}" Classes="Secondary" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc Settings_CurrentLimit}" Classes="Caption" />
                            <TextBlock Text="{Binding CurrentLimit}" Classes="Section" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{loc:Loc Settings_UsedNow}" Classes="Caption" />
                            <TextBlock Text="{Binding Used}" Classes="Section" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{Binding FreeLabel}" Classes="Caption" />
                            <TextBlock Text="{Binding Free}" Classes="Section" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="14" IsVisible="{Binding Configurable, Mode=OneTime}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="NewLimitLabel" Text="{loc:Loc Settings_NewLimit}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SizeLabels}" MinWidth="220"
                                      SelectedIndex="{Binding SizeIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding #NewLimitLabel}" />
                            <Button Grid.Column="3" Classes="accent" Click="OnApply" AutomationProperties.Name="{loc:Loc Settings_ApplyAdmin}" IsEnabled="{Binding CanApplyLimit}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Shield}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc Settings_ApplyAdmin}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <c:InfoBar IsVisible="{Binding HasApplyMessage}" Message="{Binding ApplyMessage}" Severity="{Binding ApplySeverity}" IsClosable="False" />
                        <TextBlock Text="{loc:Loc Settings_DriverDefaultHint}" Classes="Caption" />
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding HasAmdUse}">
                        <TextBlock Text="{Binding AmdUse}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding AmdPercent}" AutomationProperties.Name="AMD DirectX 12 cache use" />
                    </StackPanel>
                    <c:InfoBar IsVisible="{Binding NotConfigurable, Mode=OneTime}" Severity="Informational" IsClosable="False" Message="{Binding NotConfigurableText}" />
                    <c:InfoBar IsVisible="{Binding HasAmdAlwaysOn}" Severity="Warning" IsClosable="False" Message="{Binding AmdAlwaysOn}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsAmd, Mode=OneTime}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc Settings_KeepCachesAside}" Classes="BodyStrong" />
                            <TextBlock Text="{loc:Loc Settings_KeepCachesAsideTip}" Classes="Secondary" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" IsVisible="{Binding HasKept}">
                                <TextBlock Text="{Binding KeptSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="{loc:Loc Common_Manage}" Click="OnManageKept" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepCachesAside, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_KeepCachesAside}" />
                    </Grid>
                    <StackPanel Spacing="8" IsVisible="{Binding ShowsShaderCleanup, Mode=OneTime}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Settings_StorageSenseTitle}" Classes="BodyStrong" />
                                <TextBlock Text="{loc:Loc Settings_StorageSenseTip}" Classes="Secondary" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="OnShaderCleanup" VerticalAlignment="Center" AutomationProperties.Name="{Binding ShaderCleanupAction}" IsEnabled="{Binding CanApplyShaderCleanup}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Shield}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ShaderCleanupAction}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <c:InfoBar IsVisible="{Binding HasShaderCleanupMessage}" Message="{Binding ShaderCleanupMessage}" Severity="{Binding ShaderCleanupSeverity}" IsClosable="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <Border Classes="Card" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Loc Settings_AfterDriverUpdate}" Classes="Section" />
                        <TextBlock Text="{loc:Loc Settings_AfterDriverUpdateTip}"
                                   Classes="Secondary" TextWrapping="Wrap" />
                        <StackPanel Classes="Radios" AutomationProperties.Name="When to rebuild" IsVisible="{Binding ShowsDriverModes, Mode=OneTime}">
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="{loc:Loc Settings_DriverMode_Ask}"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=0}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_DriverMode_Ask}" />
                                    <TextBlock Text="{Binding AskNote}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="{loc:Loc Settings_DriverMode_Idle}"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=1}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_DriverMode_Idle}" />
                                    <TextBlock Text="{Binding WhenIdleNote}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="{loc:Loc Settings_DriverMode_RightAway}"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=2}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_DriverMode_RightAway}" />
                                    <TextBlock Text="{loc:Loc Settings_DriverMode_RightAwayTip}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="{loc:Loc Settings_DriverMode_Off}"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=3}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Common_Off}" />
                                    <TextBlock Text="{loc:Loc Settings_DriverMode_OffTip}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <TextBlock Text="{Binding DriverModesNote}" IsVisible="{Binding HasDriverModesNote, Mode=OneTime}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastRebuilt}" Classes="Caption" IsVisible="{Binding HasLastRebuilt}" />
                        <Rectangle Classes="Divider" />
                        <TextBlock x:Name="NewShadersHeader" Text="{loc:Loc Settings_WhenNewShaders}" Classes="Section" />
                        <TextBlock Text="{loc:Loc Settings_WhenNewShadersTip}"
                                   Classes="Secondary" TextWrapping="Wrap" />
                        <StackPanel Classes="Radios" AutomationProperties.Name="{loc:Loc Settings_WhenNewShaders}">
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="{loc:Loc Settings_DriverMode_Off}"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=0}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Common_Off}" />
                                    <TextBlock Text="{loc:Loc Settings_DriverMode_OffTip}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="{loc:Loc Settings_NewShaders_Notify}"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=1}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_NewShaders_Notify}" />
                                    <TextBlock Text="{loc:Loc Settings_NewShaders_NotifyTip}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="{loc:Loc Settings_NewShaders_AutoNotify}"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=2}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_NewShaders_AutoNotify}" />
                                    <TextBlock Text="{loc:Loc Settings_NewShaders_AutoNotifyTip}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="{loc:Loc Settings_NewShaders_AutoSilent}"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=3}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_NewShaders_AutoSilent}" />
                                    <TextBlock Text="{loc:Loc Settings_NewShaders_AutoSilentTip}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding NewShadersRightAway, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_NewShadersRightAway}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc Settings_NewShadersRightAway}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Settings_NewShadersRightAwayTip}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding CompileNewGames, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_CompileNewGames}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc Settings_CompileNewGames}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Settings_CompileNewGamesTip}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <Rectangle Classes="Divider" />
                        <CheckBox Content="{loc:Loc Settings_PauseWhileGaming}" IsChecked="{Binding PauseWhileGaming, Mode=TwoWay}" />
                        <Grid>
                            <TextBlock Text="{loc:Loc Settings_BgThreads}" />
                            <TextBlock Text="{Binding BackgroundThreadsText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="1" Maximum="{Binding MaxThreads, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding BackgroundThreads, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_BgThreads}" />
                        <StackPanel Spacing="12" IsVisible="{Binding ShowsAutoShader, Mode=OneTime}">
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="AutoBox" Content="{loc:Loc Settings_AutoShaderTitle}" IsChecked="{Binding AutoOn, Mode=TwoWay}" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Settings_SystemUtilization}" Classes="Header" />
                                        <ComboBox ItemsSource="{Binding AutoLevels}" SelectedIndex="{Binding AutoLevelIndex, Mode=TwoWay}"
                                                  IsEnabled="{Binding #AutoBox.IsChecked}" MinWidth="140" AutomationProperties.Name="{loc:Loc Settings_SystemUtilization}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="OnApplyAuto" VerticalAlignment="Bottom" AutomationProperties.Name="{loc:Loc Settings_ApplyAdmin}" IsEnabled="{Binding CanApplyAuto}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Shield}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc Settings_ApplyAdmin}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding AutoShaderText}" Classes="Caption" TextWrapping="Wrap" />
                                <c:InfoBar IsVisible="{Binding HasAutoMessage}" Message="{Binding AutoMessage}" Severity="{Binding AutoSeverity}" IsClosable="False" />
                            </StackPanel>
                            <c:InfoBar Severity="Informational" IsClosable="False" Title="{loc:Loc Settings_AutoShaderRecommend}"
                                       Message="{loc:Loc Settings_AutoShaderRecommendMsg}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">

                    <Border x:Name="PatreonCard" Classes="Card" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:Loc Settings_PatreonCard}" Classes="Section" />
                            <!-- the account's part: its DataContext is the page's AccountVm -->
                            <StackPanel x:Name="AccountPart" x:DataType="m:AccountVm" Spacing="12">
                                <StackPanel Spacing="12" IsVisible="{Binding SignedOut}">
                                    <TextBlock Text="{loc:Loc Settings_PatreonIntro}"
                                               Classes="Secondary" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Classes="accent" Content="{loc:Loc Settings_SignInPatreon}" Click="OnSignIn" IsEnabled="{Binding Idle}" />
                                        <Button Content="{loc:Loc Settings_Cancel}" Click="OnCancelSignIn" IsVisible="{Binding SigningIn}" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc Settings_SignInBrowserHint}" Classes="Caption" TextWrapping="Wrap"
                                               IsVisible="{Binding SigningIn}" />
                                </StackPanel>
                                <StackPanel Spacing="12" IsVisible="{Binding SignedIn}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{loc:Loc Settings_SignedInPatreon}" />
                                        <TextBlock Text="{Binding Benefits}" Classes="Caption" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="{loc:Loc Settings_RefreshStatus}" Click="OnRefreshAccount" IsEnabled="{Binding Idle}" />
                                        <Button Content="{loc:Loc Settings_SignOut}" Click="OnSignOut" IsEnabled="{Binding CanSignOut}" />
                                        <c:ProgressRing IsActive="{Binding Busy}" IsVisible="{Binding Busy}" Width="16" Height="16" />
                                    </StackPanel>
                                    <c:InfoBar IsVisible="{Binding OffersSharing}" Severity="Success" IsClosable="False"
                                               Title="{loc:Loc Settings_SharingOfferTitle}"
                                               Message="{loc:Loc Settings_SharingOfferMessage}">
                                        <c:InfoBar.ActionButton>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                                <Button Classes="accent" Content="{loc:Loc Settings_ShareAnonymously}" Click="OnShare" />
                                                <Button Content="{loc:Loc Settings_NotNow}" Click="OnNotNow" />
                                            </StackPanel>
                                        </c:InfoBar.ActionButton>
                                    </c:InfoBar>
                                </StackPanel>
                                <c:InfoBar IsVisible="{Binding HasProblem}" Message="{Binding Problem}" Severity="Warning" IsClosable="False" />
                                <StackPanel Spacing="8" IsVisible="{Binding ShowsUpdates}">
                                    <Rectangle Classes="Divider" />
                                    <StackPanel IsVisible="{Binding ShowsChannels}">
                                        <TextBlock Text="{loc:Loc Settings_UpdateChannel}" Classes="Header" />
                                        <ComboBox x:Name="ChannelBox" ItemsSource="{Binding ChannelLabels}" SelectedIndex="{Binding ChannelIndex, Mode=OneWay}" SelectionChanged="OnChannelPicked"
                                                  IsEnabled="{Binding CanPickChannel}" MinWidth="260" AutomationProperties.Name="{loc:Loc Settings_UpdateChannel}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ChannelNote}" Classes="Caption" TextWrapping="Wrap" />
                                    <Button Content="{loc:Loc Settings_BackToStable}" Click="OnBackToStable" IsEnabled="{Binding CanPickChannel}" IsVisible="{Binding OffersBackToStable}" />
                                    <c:InfoBar IsVisible="{Binding HasUpdateProblem}" Message="{Binding UpdateProblem}" Severity="Warning" IsClosable="False" />
                                </StackPanel>
                                <Rectangle Classes="Divider" />
                                <StackPanel Spacing="4">
                                    <CheckBox IsChecked="{Binding UseCommunityDb, Mode=TwoWay}" IsEnabled="{Binding HasDb}" AutomationProperties.Name="{loc:Loc Settings_CommunityDb}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{loc:Loc Settings_CommunityDb}" TextWrapping="Wrap" />
                                            <TextBlock Text="{loc:Loc Settings_CommunityDbTip}" Classes="Caption" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Text="{Binding DbNote}" IsVisible="{Binding HasDbNote}" Classes="Caption" TextWrapping="Wrap" Margin="28,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ShareDiagnostics, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_ShareDiagnostics}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_ShareDiagnostics}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:Loc Settings_ShareDiagnosticsTip}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ShareRecordings, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_ShareRecordings}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_ShareRecordings}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:Loc Settings_ShareRecordingsTip}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <HyperlinkButton Content="{loc:Loc Settings_WhatsShared}" NavigateUri="https://scskiller.com/privacy" Padding="0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Classes="Card" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:Loc Settings_CompileSpeed}" Classes="Section" />
                            <StackPanel Spacing="4" IsVisible="{Binding HasGpuChoices, Mode=OneTime}">
                                <TextBlock Text="{loc:Loc Settings_GpuTitle}" Classes="Header" />
                                <ComboBox ItemsSource="{Binding GpuLabels}" SelectedIndex="{Binding GpuIndex, Mode=TwoWay}"
                                          MinWidth="220" AutomationProperties.Name="{loc:Loc Settings_GpuTitle}" />
                                <TextBlock Text="{loc:Loc Settings_GpuTip}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ExperimentalIntel, Mode=TwoWay}" IsVisible="{Binding HasIntelGpu, Mode=OneTime}"
                                      AutomationProperties.Name="{loc:Loc Settings_IntelTitle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_IntelTitle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:Loc Settings_IntelTip}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <Grid>
                                <TextBlock Text="{loc:Loc Settings_CompileThreads}" />
                                <TextBlock Text="{Binding ThreadsText}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="1" Maximum="{Binding MaxThreads, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Threads, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_CompileThreads}" />
                            <TextBlock Text="{Binding PriorityNote}" Classes="Caption" />
                            <Grid>
                                <TextBlock Text="{loc:Loc Settings_MaxMemory}" />
                                <TextBlock Text="{Binding MaxCompileMemoryText}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="{Binding MaxCompileMemoryMax, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding MaxCompileMemory, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_MaxMemoryTip}" />
                            <TextBlock Text="{Binding MaxCompileMemoryNote}" TextWrapping="Wrap" Classes="Caption" />
                            <Rectangle Classes="Divider" />
                            <CheckBox IsChecked="{Binding MaximumPlans, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_MaxMode}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_MaxMode}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:Loc Settings_MaxModeTip}"
                                               Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding CompileRayTracing, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_RayTracing}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_RayTracing}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:Loc Settings_RayTracingTip}"
                                               Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Classes="Card" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Loc Settings_General}" Classes="Section" />
                        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" IsVisible="{Binding ShowsStartAtSignIn, Mode=OneTime}"
                                  AutomationProperties.Name="{Binding StartText}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding StartText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StartNote}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding CloseQuits, Mode=TwoWay}" IsVisible="{Binding ShowsCloseQuits, Mode=OneTime}"
                                  AutomationProperties.Name="{loc:Loc Settings_CloseQuits}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc Settings_CloseQuits}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CloseQuitsNote}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding BeforeAfter, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_BeforeAfter}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc Settings_BeforeAfter}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Settings_BeforeAfterTip}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding ScanAtStart, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_ScanAtStart}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc Settings_ScanAtStart}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ScanAtStartNote}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding HddMode, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_HddMode}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc Settings_HddMode}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Settings_HddModeTip}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Spacing="2" Margin="28,0,0,0" IsVisible="{Binding ShowsHddDrives}">
                            <TextBlock Text="{loc:Loc Settings_HddDrives}" Classes="Caption" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding HddDrives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:HddDriveRow">
                                        <CheckBox Content="{Binding Drive}" IsChecked="{Binding On, Mode=TwoWay}" AutomationProperties.Name="{Binding Drive}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding ActiveCheck, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_DailyCheck}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc Settings_DailyCheck}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Settings_DailyCheckTip}"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Language}" Classes="Header" />
                            <ComboBox x:Name="LanguageBox" ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex, Mode=OneWay}" SelectionChanged="OnLanguagePicked" MinWidth="220"
                                      AutomationProperties.Name="{loc:Loc Settings_Language}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings_Theme}" Classes="Header" />
                            <ComboBox x:Name="ThemeBox" ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" MinWidth="220"
                                      AutomationProperties.Name="{loc:Loc Settings_Theme}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Classes="Card" Padding="20">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc Settings_RecordAll}" Classes="Section" />
                                <TextBlock Text="{Binding RecordAllGamesNote}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding RecordAllGames, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_RecordAll}" />
                        </Grid>
                        <TextBlock Text="{Binding RecordingCount}" Classes="Caption" TextWrapping="Wrap" />
                        <StackPanel Spacing="4" IsVisible="{Binding ShowsRecordAntiCheatGames, Mode=OneTime}">
                            <CheckBox IsChecked="{Binding RecordAntiCheatGames, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_RecordAntiCheat}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Loc Settings_RecordAntiCheat}" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:Loc Settings_RecordAntiCheatTip}"
                                               Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <HyperlinkButton Content="{loc:Loc Settings_AntiCheatDetails}" Click="OnAntiCheatDetails" Padding="0" Margin="28,0,0,0" AutomationProperties.Name="Details on recording in games with anti-cheat" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding ShowsTraversal, Mode=OneTime}">
                            <Rectangle Classes="Divider" Margin="0,6" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock x:Name="TraversalLabel" Text="{loc:Loc Settings_TraversalTitle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding TraversalChoices}" MinWidth="140"
                                          SelectedIndex="{Binding TraversalIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding #TraversalLabel}" />
                            </Grid>
                            <TextBlock Text="{Binding TraversalNote}" Classes="Caption" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TraversalWarning}" IsVisible="{Binding TraversalLowVram}" Foreground="{DynamicResource WarnBrush}" Classes="Caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <Rectangle Classes="Divider" Margin="0,6" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="RecordingLimitLabel" Text="{loc:Loc Settings_RecordingLimit}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RecordingLimitLabels}" MinWidth="140"
                                      SelectedIndex="{Binding RecordingLimitIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding #RecordingLimitLabel}" />
                        </Grid>
                        <TextBlock Text="{loc:Loc Settings_RecordingLimitTip}"
                                   Classes="Caption" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RecordingSpace}" TextWrapping="Wrap" />
                        <Expander Header="{loc:Loc Settings_SpaceByGame}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="{Binding HasRecordings}">
                            <ItemsControl ItemsSource="{Binding Recordings}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:DetailRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Foreground="{DynamicResource WarnBrush}" Classes="Caption" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <StackPanel x:Name="RemoveRecordersPart" Spacing="8">
                            <Rectangle Classes="Divider" Margin="0,6" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{loc:Loc Settings_RemoveRecordersNotice}"
                                           Classes="Caption" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{loc:Loc Settings_RemoveRecorders}" Click="OnRemoveRecorders" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
