<Page
    x:Class="SCSKiller.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SCSKiller.App"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Source (Vm.Groups) is set in the constructor -->
        <CollectionViewSource x:Key="GroupedGames" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid Padding="36,28,36,28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Library" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Vm.RefreshNote, Mode=OneWay}" Visibility="{x:Bind Vm.HasRefreshNote, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                </StackPanel>
                <local:WrapPanel Grid.Row="1" Spacing="12">
                    <Button ToolTipService.ToolTip="Re-reads every game's cache size, recordings and status, and finds new games. Shift+click also re-checks every game's engine and anti-cheat (slower)." Click="OnRefresh">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.Refreshing, Mode=OneWay}" Visibility="{x:Bind Vm.Refreshing, Mode=OneWay}" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Add a game" ToolTipService.ToolTip="Add a game no store lists (another launcher, or a game in a folder of its own) by picking its .exe" Click="OnAddGame">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add a game…" />
                        </StackPanel>
                    </Button>
                    <Button Content="{x:Bind Vm.AddAllText, Mode=OneWay}"
                            Click="OnAddAll" IsEnabled="{x:Bind Vm.CanAddAll, Mode=OneWay}" />
                    <Grid>
                        <Button ToolTipService.ToolTip="Queue every game known to stutter that is ready to compile" Click="OnAddRecommended" Visibility="{x:Bind Vm.CanAddRecommended, Mode=OneWay}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5"
                                AutomationProperties.Name="{x:Bind Vm.AddRecommendedText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE734;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Vm.AddRecommendedText, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button IsEnabled="False" Visibility="{x:Bind Vm.CannotAddRecommended, Mode=OneWay}" BorderThickness="1.5"
                                AutomationProperties.Name="{x:Bind Vm.AddRecommendedText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE734;" FontSize="14" />
                                <TextBlock Text="{x:Bind Vm.AddRecommendedText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button Style="{StaticResource AccentButtonStyle}" Click="OnCompileQueue" IsEnabled="{x:Bind Vm.CanCompileQueue, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="14" />
                            <TextBlock Text="{x:Bind Vm.CompileQueueText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </local:WrapPanel>
            </Grid>
            <InfoBar Severity="Error" IsOpen="{x:Bind Vm.HasError, Mode=OneWay}" Visibility="{x:Bind Vm.HasError, Mode=OneWay}" Message="{x:Bind Vm.Error, Mode=OneWay}" IsClosable="False" />
            <InfoBar Severity="Informational" IsOpen="{x:Bind Vm.HasGpuNotice, Mode=OneWay}" Visibility="{x:Bind Vm.HasGpuNotice, Mode=OneWay}"
                     Message="{x:Bind Vm.GpuNotice, Mode=OneWay}" CloseButtonClick="OnDismissGpuNotice" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Driver shader cache" Style="{StaticResource Secondary}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Vm.CacheUsed, Mode=OneWay}" Style="{StaticResource Big}" />
                        <TextBlock Text="{x:Bind Vm.CacheLimitText, Mode=OneWay}" Style="{StaticResource Secondary}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                    </StackPanel>
                    <ProgressBar Value="{x:Bind Vm.CachePercent, Mode=OneWay}" AutomationProperties.Name="Driver shader cache use" />
                    <Grid ColumnSpacing="6" Visibility="{x:Bind Vm.CacheWarn, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarnBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Vm.CacheWarnText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource WarnBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <HyperlinkButton Content="Change" Padding="0" FontSize="12" Click="OnSettings" Visibility="{x:Bind Vm.CanRaiseLimit, Mode=OneWay}"
                                     AutomationProperties.Name="Change the driver shader cache size" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="After a driver update" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{x:Bind Vm.DriverMode, Mode=OneWay}" Style="{StaticResource Big}" />
                    <TextBlock Text="{x:Bind Vm.DriverModeNote, Mode=OneWay}" Style="{StaticResource Caption}" />
                    <HyperlinkButton Content="Change" Padding="0" FontSize="12" Click="OnSettings" AutomationProperties.Name="Change what happens after a driver update" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Compile speed" Style="{StaticResource Secondary}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Vm.Threads, Mode=OneWay}" Style="{StaticResource Big}" />
                        <TextBlock Text="{x:Bind Vm.ThreadsOf, Mode=OneWay}" Style="{StaticResource Secondary}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.SpeedNote, Mode=OneWay}" Style="{StaticResource Caption}" />
                    <HyperlinkButton Content="Change" Padding="0" FontSize="12" Click="OnSettings" AutomationProperties.Name="Change compile speed" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <!-- A rescan with games listed: one slim line above the list, rows stay usable. -->
                <Grid Visibility="{x:Bind Vm.ScanBusy, Mode=OneWay}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="20,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.ScanBusy, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                        <Run Text="Checking for new and changed games…" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{x:Bind Vm.ScanBusyNote, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                </Grid>
                <!-- Search: filters as you type (name, store or engine); Esc or the clear button resets it. -->
                <Grid Grid.Row="1" Padding="20,14,20,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="Search" PlaceholderText="Search by name, store or engine" QueryIcon="Find"
                                    TextChanged="OnSearch" KeyDown="OnSearchKey" AutomationProperties.Name="Search games" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Vm.ShownText, Mode=OneWay}" Visibility="{x:Bind Vm.Filtering, Mode=OneWay}"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </Grid>
                <!-- Same columns as the row template below. -->
                <Grid Grid.Row="2" Margin="20,0,20,0" ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.6*" MinWidth="160" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="4.1*" MinWidth="355" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Game" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="1" Text="Shaders" Style="{StaticResource Caption}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Pipelines" Style="{StaticResource Caption}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Cache" Style="{StaticResource Caption}" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Time" Style="{StaticResource Caption}" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource Caption}" Margin="12,0,0,0" />
                </Grid>
                <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <StackPanel Grid.Row="3" Visibility="{x:Bind Vm.NoMatch, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" MaxWidth="460" Padding="24">
                    <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Vm.NoMatchText, Mode=OneWay}" Style="{StaticResource Section}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="Try part of the name, a store (Steam, GOG…) or an engine (UE 5)." Style="{StaticResource Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <!-- First scan, nothing listed yet: a centred message in the list's place. -->
                <StackPanel Grid.Row="3" Visibility="{x:Bind Vm.ScanEmpty, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" MaxWidth="460" Padding="24">
                    <ProgressRing Width="32" Height="32" IsActive="{x:Bind Vm.ScanEmpty, Mode=OneWay}" />
                    <TextBlock Text="Looking for your games…" Style="{StaticResource Section}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind Vm.ScanEmptyNote}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <ListView x:Name="List" Grid.Row="3" ItemsSource="{Binding Source={StaticResource GroupedGames}}" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnGameClick" AutomationProperties.Name="Games" Padding="0,4">
                    <!-- one section per store, with its game count -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderContainerStyle>
                                <Style TargetType="ListViewHeaderItem">
                                    <Setter Property="Padding" Value="20,12,20,4" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </GroupStyle.HeaderContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="local:StoreGroup">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Store}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind CountText, Mode=OneWay}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="16,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:GameRow">
                            <Grid ColumnSpacing="12" MinHeight="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.6*" MinWidth="160" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="4.1*" MinWidth="355" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{x:Bind Tile}" Visibility="{x:Bind NoIcon}">
                                        <TextBlock Text="{x:Bind Initials}" FontSize="13" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{x:Bind Icon}" Width="32" Height="32" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,6">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Sub}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <!-- own line: next to the subtitle they'd be clipped at the default window width -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind HasTagLine}" Margin="0,2,0,0">
                                        <Border Style="{StaticResource Chip}" Height="18" Padding="6,0" CornerRadius="9" Visibility="{x:Bind IsKnownStutter}"
                                                ToolTipService.ToolTip="{x:Bind StutterTip}">
                                            <TextBlock Text="Known to stutter" FontSize="11" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                                        </Border>
                                        <ItemsControl ItemsSource="{x:Bind Tags}" IsTabStop="False" Visibility="{x:Bind HasTags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:TagChip">
                                                    <Border Style="{StaticResource Chip}" Height="18" Padding="6,0" CornerRadius="9" ToolTipService.ToolTip="{x:Bind Tip}">
                                                        <TextBlock Text="{x:Bind Text}" FontSize="11" MaxWidth="90" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{x:Bind Shaders}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Pipelines}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Cache}" Style="{x:Bind CacheStyle}" ToolTipService.ToolTip="{x:Bind CacheTip}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Time}" TextAlignment="Right" VerticalAlignment="Center" />
                                <!-- the status takes what its row's buttons leave: MinWidth 355 = a 12 gap after Time + 140 of status + the widest pair, Running + Add to queue -->
                                <Grid Grid.Column="5" ColumnSpacing="12" Margin="12,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,6" Background="Transparent" ToolTipService.ToolTip="{x:Bind RowTip}">
                                        <TextBlock Style="{x:Bind StatusStyle}" FontSize="13" TextTrimming="CharacterEllipsis">
                                            <Run Text="●" FontSize="10" /><Run Text="  " /><Run Text="{x:Bind StatusText}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind RowNote}" Visibility="{x:Bind HasRowNote}" Style="{StaticResource Caption}" Margin="16,0,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                        <!-- tooltip on a hit-testable wrapper: a disabled button shows none -->
                                        <Grid Background="Transparent" ToolTipService.ToolTip="{x:Bind PlayTip}" Visibility="{x:Bind CanLaunch}">
                                            <Button Content="{x:Bind PlayText}" IsEnabled="{x:Bind CanPlay}" Click="OnPlay" />
                                        </Grid>
                                        <Grid>
                                            <Button Content="{x:Bind AddText}" Visibility="{x:Bind IsAdd}" IsEnabled="{x:Bind CanAdd}" Click="OnAdd" />
                                            <Button Content="Details" Visibility="{x:Bind IsDetails}" Click="OnDetails" />
                                            <Button Content="Record" Style="{StaticResource WarnButton}" Visibility="{x:Bind IsRecord}" IsEnabled="{x:Bind CanRecord}" Click="OnRecord" />
                                            <Button Content="Why?" Visibility="{x:Bind IsWhy}" Click="OnWhy" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
