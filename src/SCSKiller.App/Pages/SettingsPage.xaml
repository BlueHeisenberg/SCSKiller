<Page
    x:Class="SCSKiller.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SCSKiller.App"
    xmlns:core="using:SCSKiller.Core.App">

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="36,28,36,28" Spacing="16">
            <TextBlock Text="{x:Bind core:Loc.T('Nav_Settings')}" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Vm.CacheTitle}" Style="{StaticResource Section}" />
                        <TextBlock Text="{x:Bind Vm.CacheIntro, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind core:Loc.T('Cache_CurrentLimit')}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.CurrentLimit, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind core:Loc.T('Cache_UsedNow')}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.Used, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{x:Bind Vm.FreeLabel, Mode=OneWay}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.Free, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="14" Visibility="{x:Bind Vm.Configurable}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NewLimitLabel" Text="{x:Bind core:Loc.T('Cache_NewLimit')}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SizeBox" Grid.Column="1" ItemsSource="{x:Bind local:SettingsVm.SizeLabels}" MinWidth="220"
                                      SelectedIndex="{x:Bind Vm.SizeIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{x:Bind NewLimitLabel}" />
                            <Button x:Name="ApplyButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnApply" AutomationProperties.Name="{x:Bind core:Loc.T('Cache_ApplyAdmin')}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Cache_ApplyAdmin')}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <InfoBar IsOpen="{x:Bind Vm.HasApplyMessage, Mode=OneWay}" Visibility="{x:Bind Vm.HasApplyMessage, Mode=OneWay}" Message="{x:Bind Vm.ApplyMessage, Mode=OneWay}"
                                 Severity="{x:Bind Vm.ApplySeverity, Mode=OneWay}" IsClosable="False" />
                        <TextBlock Text="{x:Bind core:Loc.T('Cache_SwitchBackNote')}" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <StackPanel Spacing="6" Visibility="{x:Bind Vm.HasAmdUse, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Vm.AmdUse, Mode=OneWay}" TextWrapping="Wrap" />
                        <ProgressBar Value="{x:Bind Vm.AmdPercent, Mode=OneWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Cache_AmdUse')}" />
                    </StackPanel>
                    <InfoBar IsOpen="{x:Bind Vm.NotConfigurable}" Visibility="{x:Bind Vm.NotConfigurable}" Severity="Informational" IsClosable="False" Message="{x:Bind Vm.NotConfigurableText, Mode=OneWay}" />
                    <InfoBar IsOpen="{x:Bind Vm.HasAmdAlwaysOn, Mode=OneWay}" Visibility="{x:Bind Vm.HasAmdAlwaysOn, Mode=OneWay}" Severity="Warning" IsClosable="False" Message="{x:Bind Vm.AmdAlwaysOn, Mode=OneWay}" />
                    <Grid ColumnSpacing="12" Visibility="{x:Bind Vm.IsAmd}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind core:Loc.T('Settings_KeepCachesAside')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind core:Loc.T('Settings_KeepAsideDesc')}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" Visibility="{x:Bind Vm.HasKept, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Vm.KeptSummary, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="{x:Bind core:Loc.T('Settings_Manage')}" Click="OnManageKept" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent=""
                                      IsOn="{x:Bind Vm.KeepCachesAside, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_KeepCachesAside')}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind core:Loc.T('Settings_AfterDriverUpdate')}" Style="{StaticResource Section}" />
                        <TextBlock Text="{x:Bind core:Loc.T('Settings_DriverUpdateDesc')}"
                                   Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        <RadioButtons SelectedIndex="{x:Bind Vm.DriverMode, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_WhenToRebuild')}">
                            <RadioButton AutomationProperties.Name="{x:Bind core:Loc.T('Settings_AskMe')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_AskMe')}" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_NewShadersNotifyDesc')}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="{x:Bind core:Loc.T('Settings_WhenIdle')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_WhenIdle')}" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_IdlePausesDesc')}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="{x:Bind core:Loc.T('Settings_RightAway')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_RightAway')}" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_RightAwayDesc')}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="{x:Bind core:Loc.T('Common_Off')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Common_Off')}" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_RebuildYourself')}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                        <TextBlock Text="{x:Bind Vm.LastRebuilt, Mode=OneWay}" Style="{StaticResource Caption}" Visibility="{x:Bind Vm.HasLastRebuilt, Mode=OneWay}" />
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <TextBlock x:Name="NewShadersHeader" Text="{x:Bind core:Loc.T('Settings_NewShadersTitle')}" Style="{StaticResource Section}" />
                        <TextBlock Text="{x:Bind core:Loc.T('Settings_NewShadersDesc')}"
                                   Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        <RadioButtons SelectedIndex="{x:Bind Vm.NewShadersChoice, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_NewShadersTitle')}">
                            <RadioButton AutomationProperties.Name="{x:Bind core:Loc.T('Common_Off')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Common_Off')}" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_NewShadersOff')}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="{x:Bind core:Loc.T('Settings_NotifyMe')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_NotifyMe')}" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_NewShadersSilentDesc')}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="{x:Bind core:Loc.T('Settings_NewShadersNotify')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_NewShadersNotify')}" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_WhenIdleDesc')}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="{x:Bind core:Loc.T('Settings_NewShadersSilent')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_NewShadersSilent')}" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_SilentDesc')}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                        <CheckBox IsChecked="{x:Bind Vm.NewShadersRightAway, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_NewShadersRightAway')}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_NewShadersRightAway')}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_NewGamesRightAwayDesc')}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.CompileNewGames, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_CompileNewGames')}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_CompileNewGames')}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_CompileNewGamesDesc')}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <CheckBox Content="{x:Bind core:Loc.T('Settings_PauseWhileGaming')}" IsChecked="{x:Bind Vm.PauseWhileGaming, Mode=TwoWay}" />
                        <Grid>
                            <TextBlock Text="{x:Bind core:Loc.T('Settings_BackgroundThreads')}" />
                            <TextBlock Text="{x:Bind Vm.BackgroundThreadsText, Mode=OneWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="1" Maximum="{x:Bind Vm.MaxThreads}" StepFrequency="1" Value="{x:Bind Vm.BackgroundThreads, Mode=TwoWay}"
                                AutomationProperties.Name="{x:Bind core:Loc.T('Settings_BackgroundThreads')}" />
                        <StackPanel Spacing="12" Visibility="{x:Bind Vm.IsNvidia}">
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="AutoBox" Content="{x:Bind core:Loc.T('Settings_AutoShaderTitle')}" IsChecked="{x:Bind Vm.AutoOn, Mode=TwoWay}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Header="{x:Bind core:Loc.T('Detail_SystemUtilization')}" ItemsSource="{x:Bind local:SettingsVm.AutoLevels}" SelectedIndex="{x:Bind Vm.AutoLevelIndex, Mode=TwoWay}"
                                              IsEnabled="{Binding IsChecked, ElementName=AutoBox}" MinWidth="140" />
                                    <Button x:Name="AutoApplyButton" Grid.Column="2" Click="OnApplyAuto" VerticalAlignment="Bottom" AutomationProperties.Name="{x:Bind core:Loc.T('Cache_ApplyAdmin')}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                            <TextBlock Text="{x:Bind core:Loc.T('Cache_ApplyAdmin')}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{x:Bind Vm.AutoShaderText, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <InfoBar IsOpen="{x:Bind Vm.HasAutoMessage, Mode=OneWay}" Visibility="{x:Bind Vm.HasAutoMessage, Mode=OneWay}" Message="{x:Bind Vm.AutoMessage, Mode=OneWay}"
                                         Severity="{x:Bind Vm.AutoSeverity, Mode=OneWay}" IsClosable="False" />
                            </StackPanel>
                            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False" Title="{x:Bind core:Loc.T('Settings_RecommendIt')}"
                                     Message="{x:Bind core:Loc.T('Settings_AutoShaderDesc')}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border x:Name="PatreonCard" Style="{StaticResource Card}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind core:Loc.T('Settings_PatreonTitle')}" Style="{StaticResource Section}" />
                            <StackPanel Spacing="12" Visibility="{x:Bind Patreon.SignedOut, Mode=OneWay}">
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_PatreonDesc')}"
                                           Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="{x:Bind core:Loc.T('Settings_SignInPatreon')}" Click="OnSignIn" IsEnabled="{x:Bind Patreon.Idle, Mode=OneWay}" />
                                    <Button Content="{x:Bind core:Loc.T('Common_Cancel')}" Click="OnCancelSignIn" Visibility="{x:Bind Patreon.SigningIn, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_SignInBrowser')}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Visibility="{x:Bind Patreon.SigningIn, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Spacing="12" Visibility="{x:Bind Patreon.SignedIn, Mode=OneWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_SignedIn')}" />
                                    <TextBlock Text="{x:Bind Patreon.Benefits, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="{x:Bind core:Loc.T('Detail_RefreshStatus')}" Click="OnRefreshAccount" IsEnabled="{x:Bind Patreon.Idle, Mode=OneWay}" />
                                    <Button Content="{x:Bind core:Loc.T('Settings_SignOut')}" Click="OnSignOut" IsEnabled="{x:Bind Patreon.CanSignOut, Mode=OneWay}" />
                                    <ProgressRing IsActive="{x:Bind Patreon.Busy, Mode=OneWay}" Width="16" Height="16" />
                                </StackPanel>
                                <InfoBar IsOpen="{x:Bind Patreon.OffersSharing, Mode=OneWay}" Visibility="{x:Bind Patreon.OffersSharing, Mode=OneWay}" Severity="Success" IsClosable="False"
                                         Title="{x:Bind core:Loc.T('Settings_YouInPrompt')}"
                                         Message="{x:Bind core:Loc.T('Settings_SharedAnonNote')}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <Button Style="{StaticResource AccentButtonStyle}" Content="{x:Bind core:Loc.T('Settings_ShareAnonymously')}" Click="OnShare" />
                                        <Button Content="{x:Bind core:Loc.T('Common_NotNow')}" Click="OnNotNow" />
                                    </StackPanel>
                                </InfoBar>
                            </StackPanel>
                            <InfoBar IsOpen="{x:Bind Patreon.HasProblem, Mode=OneWay}" Visibility="{x:Bind Patreon.HasProblem, Mode=OneWay}" Message="{x:Bind Patreon.Problem, Mode=OneWay}"
                                     Severity="Warning" IsClosable="False" />
                            <StackPanel Spacing="8" Visibility="{x:Bind Patreon.ShowsUpdates, Mode=OneWay}">
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <ComboBox Header="{x:Bind core:Loc.T('Settings_UpdateChannel')}" ItemsSource="{x:Bind Patreon.ChannelLabels, Mode=OneWay}" SelectedIndex="{x:Bind Patreon.ChannelIndex, Mode=TwoWay}"
                                          IsEnabled="{x:Bind Patreon.CanPickChannel, Mode=OneWay}" MinWidth="260" Visibility="{x:Bind Patreon.ShowsChannels, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Patreon.ChannelNote, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <Button Content="{x:Bind core:Loc.T('Settings_BackToStable')}" Click="OnBackToStable" IsEnabled="{x:Bind Patreon.CanPickChannel, Mode=OneWay}" Visibility="{x:Bind Patreon.OffersBackToStable, Mode=OneWay}" />
                                <InfoBar IsOpen="{x:Bind Patreon.HasUpdateProblem, Mode=OneWay}" Visibility="{x:Bind Patreon.HasUpdateProblem, Mode=OneWay}"
                                         Message="{x:Bind Patreon.UpdateProblem, Mode=OneWay}" Severity="Warning" IsClosable="False" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <StackPanel Spacing="4">
                                <CheckBox IsChecked="{x:Bind Patreon.UseCommunityDb, Mode=TwoWay}" IsEnabled="{x:Bind Patreon.HasDb, Mode=OneWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_DownloadShared')}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind core:Loc.T('Settings_DownloadShared')}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind core:Loc.T('Settings_UseSharedDesc')}"
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Text="{x:Bind Patreon.DbNote, Mode=OneWay}" Visibility="{x:Bind Patreon.HasDbNote, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,0,0,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{x:Bind Vm.ShareDiagnostics, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_ShareDiagnostics')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_ShareDiagnostics')}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_DiagnosticsDesc')}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{x:Bind Vm.ShareRecordings, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_ShareHashes')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_ShareHashes')}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_ShareDesc')}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <HyperlinkButton Content="{x:Bind core:Loc.T('Settings_WhatsShared')}" NavigateUri="https://scskiller.com/privacy" Padding="0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind core:Loc.T('Settings_QueueSpeed')}" Style="{StaticResource Section}" />
                            <StackPanel Spacing="4" Visibility="{x:Bind Vm.HasGpuChoices}">
                                <ComboBox Header="{x:Bind core:Loc.T('Settings_GpuToCompileFor')}" ItemsSource="{x:Bind Vm.GpuLabels}" SelectedIndex="{x:Bind Vm.GpuIndex, Mode=TwoWay}"
                                          MinWidth="220" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_GpuToCompileFor')}" />
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_GpuDesc')}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox IsChecked="{x:Bind Vm.ExperimentalIntel, Mode=TwoWay}" Visibility="{x:Bind Vm.HasIntelGpu}"
                                      AutomationProperties.Name="{x:Bind core:Loc.T('Settings_ExperimentalIntel')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_ExperimentalIntel')}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_IntelNote')}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <Grid>
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_CompileThreads')}" />
                                <TextBlock Text="{x:Bind Vm.ThreadsText, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="1" Maximum="{x:Bind Vm.MaxThreads}" StepFrequency="1" Value="{x:Bind Vm.Threads, Mode=TwoWay}"
                                    AutomationProperties.Name="{x:Bind core:Loc.T('Settings_CompileThreads')}" />
                            <TextBlock Text="{x:Bind Vm.PriorityNote, Mode=OneWay}" Style="{StaticResource Caption}" />
                            <Grid>
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_MaxMemory')}" />
                                <TextBlock Text="{x:Bind Vm.MaxCompileMemoryText, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="{x:Bind Vm.MaxCompileMemoryMax}" StepFrequency="1" Value="{x:Bind Vm.MaxCompileMemory, Mode=TwoWay}"
                                    AutomationProperties.Name="{x:Bind core:Loc.T('Settings_MaxMemory0')}" />
                            <TextBlock Text="{x:Bind Vm.MaxCompileMemoryNote}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <CheckBox IsChecked="{x:Bind Vm.MaximumPlans, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_MaximumMode')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_MaximumMode')}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_MaximumModeDesc')}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{x:Bind Vm.CompileRayTracing, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_CompileRayTracing')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_CompileRayTracing')}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_RayTracingOffDesc')}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind core:Loc.T('Settings_General')}" Style="{StaticResource Section}" />
                        <CheckBox IsChecked="{x:Bind Vm.StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_StartWithWindows')}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_StartWithWindows')}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_TrayDesc')}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.CloseQuits, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_CloseQuits')}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_CloseQuits')}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_CloseQuitsDesc')}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.BeforeAfter, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Detail_BeforeAfter')}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind core:Loc.T('Detail_BeforeAfter')}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind core:Loc.T('Detail_BeforeAfterDesc')}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.ScanAtStart, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_ScanAtStart')}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_ScanAtStart')}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_ScanAtStartDesc')}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.HddMode, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_HddMode')}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_HddMode')}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_HddDesc')}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Spacing="2" Margin="28,0,0,0" Visibility="{x:Bind Vm.ShowsHddDrives, Mode=OneWay}">
                            <TextBlock Text="{x:Bind core:Loc.T('Settings_HddDrives')}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <ItemsRepeater ItemsSource="{x:Bind Vm.HddDrives, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:HddDriveRow">
                                        <CheckBox Content="{x:Bind Drive}" IsChecked="{x:Bind On, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Drive}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                        <CheckBox IsChecked="{x:Bind Vm.ActiveCheck, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_ActiveCheck')}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_ActiveCheck')}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_ActiveCheckDesc')}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <ComboBox Header="{x:Bind core:Loc.T('Settings_Theme')}" ItemsSource="{x:Bind local:SettingsVm.Themes}" SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}" MinWidth="220"
                                  AutomationProperties.Name="{x:Bind core:Loc.T('Settings_Theme')}" />
                        <ComboBox Header="{x:Bind core:Loc.T('Settings_Language')}" ItemsSource="{x:Bind local:SettingsVm.LanguageNames}"
                                  SelectedIndex="{x:Bind Vm.LanguageIndex, Mode=TwoWay}" MinWidth="220"
                                  AutomationProperties.Name="{x:Bind core:Loc.T('Settings_Language')}" />
                        <TextBlock Text="{x:Bind core:Loc.T('Settings_RestartToApply')}" Style="{StaticResource Caption}"
                                   Visibility="{x:Bind Vm.LanguageRestarts, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_RecordAllGames')}" Style="{StaticResource Section}" />
                                <TextBlock Text="{x:Bind core:Loc.T('Settings_RecorderDesc')}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent="" IsOn="{x:Bind Vm.RecordAllGames, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Bind core:Loc.T('Settings_RecordAllGames')}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.RecordingCount, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <CheckBox IsChecked="{x:Bind Vm.RecordAntiCheatGames, Mode=TwoWay}" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_AllowAntiCheatRecorder')}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_AllowAntiCheatRecorder')}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind core:Loc.T('Settings_AllowAntiCheatDesc')}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <HyperlinkButton Content="{x:Bind core:Loc.T('Common_Details')}" Click="OnAntiCheatDetails" Padding="0" Margin="28,0,0,0" AutomationProperties.Name="{x:Bind core:Loc.T('Settings_AntiCheatDetails')}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Visibility="{x:Bind Vm.TraversalVisibility}">
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,6" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TraversalLabel" Text="{x:Bind core:Loc.T('Settings_TraversalTitle')}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:SettingsVm.TraversalChoices}" MinWidth="140"
                                          SelectedIndex="{x:Bind Vm.TraversalIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{x:Bind TraversalLabel}" />
                            </Grid>
                            <TextBlock Text="{x:Bind Vm.TraversalNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Vm.TraversalWarning}" Visibility="{x:Bind Vm.TraversalWarningVisibility}" Foreground="{ThemeResource WarnBrush}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,6" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RecordingLimitLabel" Text="{x:Bind core:Loc.T('Settings_RecordingLimit')}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:SettingsVm.RecordingLimitLabels}" MinWidth="140"
                                      SelectedIndex="{x:Bind Vm.RecordingLimitIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{x:Bind RecordingLimitLabel}" />
                        </Grid>
                        <TextBlock Text="{x:Bind core:Loc.T('Settings_RecordingLimitDesc')}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Vm.RecordingSpace, Mode=OneWay}" TextWrapping="Wrap" />
                        <Expander Header="{x:Bind core:Loc.T('Cache_SpaceByGame')}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind Vm.HasRecordings, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind Vm.Recordings, Mode=OneWay}">
                                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:DetailRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind HasNote}" Foreground="{ThemeResource WarnBrush}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
