<Page
    x:Class="SCSKiller.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SCSKiller.App">

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="36,28,36,28" Spacing="16">
            <TextBlock x:Uid="SettingsPage_Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="8">
                    <ComboBox x:Uid="SettingsPage_LanguageBox" x:Name="LanguageBox" MinWidth="240"
                              ItemsSource="{x:Bind Vm.LanguageNames}" SelectedIndex="{x:Bind Vm.LanguageIndex, Mode=TwoWay}" />
                    <TextBlock x:Uid="SettingsPage_LanguageNote" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Vm.CacheTitle}" Style="{StaticResource Section}" />
                        <TextBlock Text="{x:Bind Vm.CacheIntro}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="SettingsPage_CurrentLimit" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.CurrentLimit, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="SettingsPage_UsedNow" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.Used, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{x:Bind Vm.FreeLabel, Mode=OneWay}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.Free, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="14" Visibility="{x:Bind Vm.Configurable}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsPage_NewLimitLabel" x:Name="NewLimitLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="SizeBox" Grid.Column="1" ItemsSource="{x:Bind local:SettingsVm.SizeLabels}" MinWidth="220"
                                      SelectedIndex="{x:Bind Vm.SizeIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{x:Bind NewLimitLabel}" />
                            <Button x:Name="ApplyButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnApply">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                    <TextBlock x:Uid="SettingsPage_ApplyNeedsAdministrator" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <InfoBar IsOpen="{x:Bind Vm.HasApplyMessage, Mode=OneWay}" Visibility="{x:Bind Vm.HasApplyMessage, Mode=OneWay}" Message="{x:Bind Vm.ApplyMessage, Mode=OneWay}"
                                 Severity="{x:Bind Vm.ApplySeverity, Mode=OneWay}" IsClosable="False" />
                        <TextBlock x:Uid="SettingsPage_YouCanSwitchBack" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <InfoBar IsOpen="{x:Bind Vm.NotConfigurable}" Visibility="{x:Bind Vm.NotConfigurable}" Severity="Informational" IsClosable="False" Message="{x:Bind Vm.NotConfigurableText}" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsPage_AfterADriverUpdate" Style="{StaticResource Section}" />
                        <TextBlock x:Uid="SettingsPage_ANewDriverThrows"
                                   Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        <RadioButtons x:Uid="SettingsPage_WhenToRebuild" SelectedIndex="{x:Bind Vm.DriverMode, Mode=TwoWay}">
                            <RadioButton x:Uid="SettingsPage_AskMe">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="SettingsPage_AskMeTextBlock" />
                                    <TextBlock x:Uid="SettingsPage_ANotificationOffersCompile" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Uid="SettingsPage_AutomaticallyOnlyWhileThe">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="SettingsPage_AutomaticallyOnlyWhileTheTextBlock" />
                                    <TextBlock x:Uid="SettingsPage_StopsTheMomentYou" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Uid="SettingsPage_Off">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="SettingsPage_OffTextBlock" />
                                    <TextBlock x:Uid="SettingsPage_RebuildGamesYourselfFrom" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                        <TextBlock Text="{x:Bind Vm.LastRebuilt, Mode=OneWay}" Style="{StaticResource Caption}" Visibility="{x:Bind Vm.HasLastRebuilt, Mode=OneWay}" />
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <CheckBox x:Uid="SettingsPage_PauseBackgroundCompilingWhile" IsChecked="{x:Bind Vm.PauseWhileGaming, Mode=TwoWay}" />
                        <Grid>
                            <TextBlock x:Uid="SettingsPage_ThreadsForBackgroundRebuilds" />
                            <TextBlock Text="{x:Bind Vm.BackgroundThreadsText, Mode=OneWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Uid="SettingsPage_ThreadsForBackgroundRebuildsSlider" Minimum="1" Maximum="{x:Bind Vm.MaxThreads}" StepFrequency="1" Value="{x:Bind Vm.BackgroundThreads, Mode=TwoWay}" />
                        <StackPanel Spacing="12" Visibility="{x:Bind Vm.IsNvidia}">
                            <StackPanel Spacing="8">
                                <CheckBox x:Uid="SettingsPage_AutoBox" x:Name="AutoBox" IsChecked="{x:Bind Vm.AutoOn, Mode=TwoWay}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Uid="SettingsPage_SystemUtilization" ItemsSource="{x:Bind local:SettingsVm.AutoLevels}" SelectedIndex="{x:Bind Vm.AutoLevelIndex, Mode=TwoWay}"
                                              IsEnabled="{Binding IsChecked, ElementName=AutoBox}" MinWidth="140" />
                                    <Button x:Name="AutoApplyButton" Grid.Column="2" Click="OnApplyAuto" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                            <TextBlock x:Uid="SettingsPage_ApplyNeedsAdministratorTextBlock" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{x:Bind Vm.AutoShaderText, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <InfoBar IsOpen="{x:Bind Vm.HasAutoMessage, Mode=OneWay}" Visibility="{x:Bind Vm.HasAutoMessage, Mode=OneWay}" Message="{x:Bind Vm.AutoMessage, Mode=OneWay}"
                                         Severity="{x:Bind Vm.AutoSeverity, Mode=OneWay}" IsClosable="False" />
                            </StackPanel>
                            <InfoBar x:Uid="SettingsPage_WeRecommendEnablingIt" IsOpen="True" Severity="Informational" IsClosable="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border x:Name="PatreonCard" Style="{StaticResource Card}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="SettingsPage_PatreonAndCommunityDatabase" Style="{StaticResource Section}" />
                            <StackPanel Spacing="12" Visibility="{x:Bind Patreon.SignedOut, Mode=OneWay}">
                                <TextBlock x:Uid="SettingsPage_PatreonSupportersGetThe"
                                           Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Uid="SettingsPage_SignInWithPatreon" Style="{StaticResource AccentButtonStyle}" Click="OnSignIn" IsEnabled="{x:Bind Patreon.Idle, Mode=OneWay}" />
                                    <Button x:Uid="SettingsPage_Cancel" Click="OnCancelSignIn" Visibility="{x:Bind Patreon.SigningIn, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock x:Uid="SettingsPage_FinishSigningInIn" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Visibility="{x:Bind Patreon.SigningIn, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Spacing="12" Visibility="{x:Bind Patreon.SignedIn, Mode=OneWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="SettingsPage_SignedInWithPatreon" />
                                    <TextBlock Text="{x:Bind Patreon.Benefits, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Uid="SettingsPage_RefreshStatus" Click="OnRefreshAccount" IsEnabled="{x:Bind Patreon.Idle, Mode=OneWay}" />
                                    <Button x:Uid="SettingsPage_SignOut" Click="OnSignOut" IsEnabled="{x:Bind Patreon.CanSignOut, Mode=OneWay}" />
                                    <ProgressRing IsActive="{x:Bind Patreon.Busy, Mode=OneWay}" Width="16" Height="16" />
                                </StackPanel>
                                <InfoBar x:Uid="SettingsPage_YoureInWantTo" IsOpen="{x:Bind Patreon.OffersSharing, Mode=OneWay}" Visibility="{x:Bind Patreon.OffersSharing, Mode=OneWay}" Severity="Success" IsClosable="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <Button x:Uid="SettingsPage_ShareAnonymously" Style="{StaticResource AccentButtonStyle}" Click="OnShare" />
                                        <Button x:Uid="SettingsPage_NotNow" Click="OnNotNow" />
                                    </StackPanel>
                                </InfoBar>
                            </StackPanel>
                            <InfoBar IsOpen="{x:Bind Patreon.HasProblem, Mode=OneWay}" Visibility="{x:Bind Patreon.HasProblem, Mode=OneWay}" Message="{x:Bind Patreon.Problem, Mode=OneWay}"
                                     Severity="Warning" IsClosable="False" />
                            <StackPanel Spacing="8" Visibility="{x:Bind Patreon.ShowsUpdates, Mode=OneWay}">
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <ComboBox x:Uid="SettingsPage_UpdateChannel" ItemsSource="{x:Bind Patreon.ChannelLabels, Mode=OneWay}" SelectedIndex="{x:Bind Patreon.ChannelIndex, Mode=TwoWay}"
                                          IsEnabled="{x:Bind Patreon.CanPickChannel, Mode=OneWay}" MinWidth="260" Visibility="{x:Bind Patreon.ShowsChannels, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Patreon.ChannelNote, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <Button x:Uid="SettingsPage_GoBackToStable" Click="OnBackToStable" IsEnabled="{x:Bind Patreon.CanPickChannel, Mode=OneWay}" Visibility="{x:Bind Patreon.OffersBackToStable, Mode=OneWay}" />
                                <InfoBar IsOpen="{x:Bind Patreon.HasUpdateProblem, Mode=OneWay}" Visibility="{x:Bind Patreon.HasUpdateProblem, Mode=OneWay}"
                                         Message="{x:Bind Patreon.UpdateProblem, Mode=OneWay}" Severity="Warning" IsClosable="False" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <StackPanel Spacing="4">
                                <CheckBox x:Uid="SettingsPage_DownloadSharedShaderHashes" IsChecked="{x:Bind Patreon.UseCommunityDb, Mode=TwoWay}" IsEnabled="{x:Bind Patreon.HasDb, Mode=OneWay}">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="SettingsPage_DownloadSharedShaderHashesTextBlock" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="SettingsPage_HashesOtherPlayersRecorded"
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Text="{x:Bind Patreon.DbNote, Mode=OneWay}" Visibility="{x:Bind Patreon.HasDbNote, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,0,0,0" />
                            </StackPanel>
                            <CheckBox x:Uid="SettingsPage_ShareAnonymousShaderHashes" IsChecked="{x:Bind Vm.ShareRecordings, Mode=TwoWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="SettingsPage_ShareAnonymousShaderHashesTextBlock" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="SettingsPage_HelpsEveryoneGetBetter" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="SettingsPage_CompileSpeedWhenYou" Style="{StaticResource Section}" />
                            <Grid>
                                <TextBlock x:Uid="SettingsPage_CompileThreads" />
                                <TextBlock Text="{x:Bind Vm.ThreadsText, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Uid="SettingsPage_CompileThreadsSlider" Minimum="1" Maximum="{x:Bind Vm.MaxThreads}" StepFrequency="1" Value="{x:Bind Vm.Threads, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind Vm.PriorityNote, Mode=OneWay}" Style="{StaticResource Caption}" />
                            <Grid>
                                <TextBlock x:Uid="SettingsPage_MaximumMemoryForCompiling" />
                                <TextBlock Text="{x:Bind Vm.MaxCompileMemoryText, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Uid="SettingsPage_MaximumMemoryForCompilingSlider" Minimum="0" Maximum="16" StepFrequency="1" Value="{x:Bind Vm.MaxCompileMemory, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind Vm.MaxCompileMemoryNote}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <CheckBox x:Uid="SettingsPage_MaximumModeAlsoCompile" IsChecked="{x:Bind Vm.MaximumPlans, Mode=TwoWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="SettingsPage_MaximumModeAlsoCompileTextBlock" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="SettingsPage_SeemsToHelpMost"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsPage_InTheBackground" Style="{StaticResource Section}" />
                        <CheckBox x:Uid="SettingsPage_StartSCSKillerWhenWindows" IsChecked="{x:Bind Vm.StartWithWindows, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="SettingsPage_StartSCSKillerWhenWindowsTextBlock" TextWrapping="Wrap" />
                                <TextBlock x:Uid="SettingsPage_ItWaitsInThe"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Uid="SettingsPage_ClosingTheWindowQuits" IsChecked="{x:Bind Vm.CloseQuits, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="SettingsPage_ClosingTheWindowQuitsTextBlock" TextWrapping="Wrap" />
                                <TextBlock x:Uid="SettingsPage_ARunningCompileFinishes"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Uid="SettingsPage_ScanGamesWhenSCSKiller" IsChecked="{x:Bind Vm.ScanAtStart, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="SettingsPage_ScanGamesWhenSCSKillerTextBlock" TextWrapping="Wrap" />
                                <TextBlock x:Uid="SettingsPage_ReadsAgainWhatChanged"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Uid="SettingsPage_NotifyMeWhenGames" IsChecked="{x:Bind Vm.NotifyNewShaders, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="SettingsPage_NotifyMeWhenGamesTextBlock" TextWrapping="Wrap" />
                                <TextBlock x:Uid="SettingsPage_ACompiledGameGains"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Uid="SettingsPage_SendAnAnonymousDaily" IsChecked="{x:Bind Vm.ActiveCheck, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="SettingsPage_SendAnAnonymousDailyTextBlock" TextWrapping="Wrap" />
                                <TextBlock x:Uid="SettingsPage_CountsActiveInstallsOnce"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="SettingsPage_RecordInAllCompatible" Style="{StaticResource Section}" />
                                <TextBlock x:Uid="SettingsPage_AddsASmallD3d12"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Uid="SettingsPage_RecordInAllCompatibleToggleSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent="" IsOn="{x:Bind Vm.RecordAllGames, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.RecordingCount, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,6" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsPage_RecordingLimitLabel" x:Name="RecordingLimitLabel" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:SettingsVm.RecordingLimitLabels}" MinWidth="140"
                                      SelectedIndex="{x:Bind Vm.RecordingLimitIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{x:Bind RecordingLimitLabel}" />
                        </Grid>
                        <TextBlock x:Uid="SettingsPage_CountsTheRecordingIn"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Vm.RecordingSpace, Mode=OneWay}" TextWrapping="Wrap" />
                        <Expander x:Uid="SettingsPage_SpaceByGame" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind Vm.HasRecordings, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind Vm.Recordings, Mode=OneWay}">
                                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:DetailRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind HasNote}" Foreground="{ThemeResource WarnBrush}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
