<Page
    x:Class="SCSKiller.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SCSKiller.App">

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="36,28,36,28" Spacing="16">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Vm.CacheTitle}" Style="{StaticResource Section}" />
                        <TextBlock Text="{x:Bind Vm.CacheIntro, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Current limit" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.CurrentLimit, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Used now" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.Used, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{x:Bind Vm.FreeLabel, Mode=OneWay}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.Free, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="14" Visibility="{x:Bind Vm.Configurable}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NewLimitLabel" Text="New limit" VerticalAlignment="Center" />
                            <ComboBox x:Name="SizeBox" Grid.Column="1" ItemsSource="{x:Bind local:SettingsVm.SizeLabels}" MinWidth="220"
                                      SelectedIndex="{x:Bind Vm.SizeIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{x:Bind NewLimitLabel}" />
                            <Button x:Name="ApplyButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnApply">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                    <TextBlock Text="Apply (needs administrator)" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <InfoBar IsOpen="{x:Bind Vm.HasApplyMessage, Mode=OneWay}" Visibility="{x:Bind Vm.HasApplyMessage, Mode=OneWay}" Message="{x:Bind Vm.ApplyMessage, Mode=OneWay}"
                                 Severity="{x:Bind Vm.ApplySeverity, Mode=OneWay}" IsClosable="False" />
                        <TextBlock Text="You can switch back to the driver default here at any time." Style="{StaticResource Caption}" />
                    </StackPanel>
                    <StackPanel Spacing="6" Visibility="{x:Bind Vm.HasAmdUse, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Vm.AmdUse, Mode=OneWay}" TextWrapping="Wrap" />
                        <ProgressBar Value="{x:Bind Vm.AmdPercent, Mode=OneWay}" AutomationProperties.Name="AMD DirectX 12 cache use" />
                    </StackPanel>
                    <InfoBar IsOpen="{x:Bind Vm.NotConfigurable}" Visibility="{x:Bind Vm.NotConfigurable}" Severity="Informational" IsClosable="False" Message="{x:Bind Vm.NotConfigurableText, Mode=OneWay}" />
                    <Grid ColumnSpacing="12" Visibility="{x:Bind Vm.IsAmd}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Keep compiled caches aside" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Puts a game's compiled cache back after the driver removes it." Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" Visibility="{x:Bind Vm.HasKept, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Vm.KeptSummary, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="Manage…" Click="OnManageKept" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent=""
                                      IsOn="{x:Bind Vm.KeepCachesAside, Mode=TwoWay}" AutomationProperties.Name="Keep compiled caches aside" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="After a driver update" Style="{StaticResource Section}" />
                        <TextBlock Text="A new driver throws away every compiled shader, so compiled games stutter again until they are rebuilt."
                                   Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        <RadioButtons SelectedIndex="{x:Bind Vm.DriverMode, Mode=TwoWay}" AutomationProperties.Name="When to rebuild">
                            <RadioButton AutomationProperties.Name="Ask me">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Ask me" />
                                    <TextBlock Text="A notification offers Compile now, When idle, or Skip. Nothing starts on its own." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Automatically, only while the PC is idle">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Automatically, only while the PC is idle" />
                                    <TextBlock Text="Stops the moment you touch the mouse or keyboard and picks up where it left off." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Off">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Off" />
                                    <TextBlock Text="Rebuild games yourself from the Library." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                        <TextBlock Text="{x:Bind Vm.LastRebuilt, Mode=OneWay}" Style="{StaticResource Caption}" Visibility="{x:Bind Vm.HasLastRebuilt, Mode=OneWay}" />
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <TextBlock x:Name="NewShadersHeader" Text="When games have new shaders" Style="{StaticResource Section}" />
                        <TextBlock Text="A compiled game gains pipelines from its recording, the shared shader hashes or an SCSKiller update. Never while you play."
                                   Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        <RadioButtons SelectedIndex="{x:Bind Vm.NewShadersChoice, Mode=TwoWay}" AutomationProperties.Name="When games have new shaders">
                            <RadioButton AutomationProperties.Name="Off">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Off" />
                                    <TextBlock Text="Compile games yourself from the Library." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Notify me">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Notify me" />
                                    <TextBlock Text="A notification offers Compile now. Nothing starts on its own." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Compile automatically and notify me">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Compile automatically and notify me" />
                                    <TextBlock Text="Compiles while the PC is idle and tells you it's queued." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Compile automatically, silently">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Compile automatically, silently" />
                                    <TextBlock Text="Compiles while the PC is idle with no notification." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <CheckBox Content="Pause background compiling while another game is running" IsChecked="{x:Bind Vm.PauseWhileGaming, Mode=TwoWay}" />
                        <Grid>
                            <TextBlock Text="Threads for background rebuilds" />
                            <TextBlock Text="{x:Bind Vm.BackgroundThreadsText, Mode=OneWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="1" Maximum="{x:Bind Vm.MaxThreads}" StepFrequency="1" Value="{x:Bind Vm.BackgroundThreads, Mode=TwoWay}"
                                AutomationProperties.Name="Threads for background rebuilds" />
                        <StackPanel Spacing="12" Visibility="{x:Bind Vm.IsNvidia}">
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="AutoBox" Content="Auto Shader Compilation (NVIDIA beta)" IsChecked="{x:Bind Vm.AutoOn, Mode=TwoWay}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Header="System utilization" ItemsSource="{x:Bind local:SettingsVm.AutoLevels}" SelectedIndex="{x:Bind Vm.AutoLevelIndex, Mode=TwoWay}"
                                              IsEnabled="{Binding IsChecked, ElementName=AutoBox}" MinWidth="140" />
                                    <Button x:Name="AutoApplyButton" Grid.Column="2" Click="OnApplyAuto" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                            <TextBlock Text="Apply (needs administrator)" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{x:Bind Vm.AutoShaderText, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <InfoBar IsOpen="{x:Bind Vm.HasAutoMessage, Mode=OneWay}" Visibility="{x:Bind Vm.HasAutoMessage, Mode=OneWay}" Message="{x:Bind Vm.AutoMessage, Mode=OneWay}"
                                         Severity="{x:Bind Vm.AutoSeverity, Mode=OneWay}" IsClosable="False" />
                            </StackPanel>
                            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False" Title="We recommend enabling it"
                                     Message="A beta feature of the NVIDIA App: after a driver update it re-compiles the games you have already played. SCSKiller adds everything else, so both together are best. The overlap costs little: shaders NVIDIA already rebuilt take about 1 ms each here." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border x:Name="PatreonCard" Style="{StaticResource Card}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Patreon and community database" Style="{StaticResource Section}" />
                            <StackPanel Spacing="12" Visibility="{x:Bind Patreon.SignedOut, Mode=OneWay}">
                                <TextBlock Text="Patreon supporters get the community shader hash database and beta and alpha builds. Sign in with the Patreon account you support SCSKiller with."
                                           Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="Sign in with Patreon" Click="OnSignIn" IsEnabled="{x:Bind Patreon.Idle, Mode=OneWay}" />
                                    <Button Content="Cancel" Click="OnCancelSignIn" Visibility="{x:Bind Patreon.SigningIn, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="Finish signing in in your browser. Nothing else is needed here." Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Visibility="{x:Bind Patreon.SigningIn, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Spacing="12" Visibility="{x:Bind Patreon.SignedIn, Mode=OneWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Signed in with Patreon" />
                                    <TextBlock Text="{x:Bind Patreon.Benefits, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Refresh status" Click="OnRefreshAccount" IsEnabled="{x:Bind Patreon.Idle, Mode=OneWay}" />
                                    <Button Content="Sign out" Click="OnSignOut" IsEnabled="{x:Bind Patreon.CanSignOut, Mode=OneWay}" />
                                    <ProgressRing IsActive="{x:Bind Patreon.Busy, Mode=OneWay}" Width="16" Height="16" />
                                </StackPanel>
                                <InfoBar IsOpen="{x:Bind Patreon.OffersSharing, Mode=OneWay}" Visibility="{x:Bind Patreon.OffersSharing, Mode=OneWay}" Severity="Success" IsClosable="False"
                                         Title="You're in. Want to help improve the community shader hash database?"
                                         Message="Your game shader hashes are shared anonymously, never linked to your Patreon account.">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <Button Style="{StaticResource AccentButtonStyle}" Content="Share anonymously" Click="OnShare" />
                                        <Button Content="Not now" Click="OnNotNow" />
                                    </StackPanel>
                                </InfoBar>
                            </StackPanel>
                            <InfoBar IsOpen="{x:Bind Patreon.HasProblem, Mode=OneWay}" Visibility="{x:Bind Patreon.HasProblem, Mode=OneWay}" Message="{x:Bind Patreon.Problem, Mode=OneWay}"
                                     Severity="Warning" IsClosable="False" />
                            <StackPanel Spacing="8" Visibility="{x:Bind Patreon.ShowsUpdates, Mode=OneWay}">
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <ComboBox Header="Update channel" ItemsSource="{x:Bind Patreon.ChannelLabels, Mode=OneWay}" SelectedIndex="{x:Bind Patreon.ChannelIndex, Mode=TwoWay}"
                                          IsEnabled="{x:Bind Patreon.CanPickChannel, Mode=OneWay}" MinWidth="260" Visibility="{x:Bind Patreon.ShowsChannels, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Patreon.ChannelNote, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <Button Content="Go back to stable now" Click="OnBackToStable" IsEnabled="{x:Bind Patreon.CanPickChannel, Mode=OneWay}" Visibility="{x:Bind Patreon.OffersBackToStable, Mode=OneWay}" />
                                <InfoBar IsOpen="{x:Bind Patreon.HasUpdateProblem, Mode=OneWay}" Visibility="{x:Bind Patreon.HasUpdateProblem, Mode=OneWay}"
                                         Message="{x:Bind Patreon.UpdateProblem, Mode=OneWay}" Severity="Warning" IsClosable="False" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <StackPanel Spacing="4">
                                <CheckBox IsChecked="{x:Bind Patreon.UseCommunityDb, Mode=TwoWay}" IsEnabled="{x:Bind Patreon.HasDb, Mode=OneWay}" AutomationProperties.Name="Download shared shader hashes">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Download shared shader hashes" TextWrapping="Wrap" />
                                        <TextBlock Text="Compile your games with hashes other players recorded."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Text="{x:Bind Patreon.DbNote, Mode=OneWay}" Visibility="{x:Bind Patreon.HasDbNote, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,0,0,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{x:Bind Vm.ShareDiagnostics, Mode=TwoWay}" AutomationProperties.Name="Share diagnostics to help fix problems">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Share diagnostics to help fix problems" TextWrapping="Wrap" />
                                    <TextBlock Text="When a compile fails, send its error codes, once per compile." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{x:Bind Vm.ShareRecordings, Mode=TwoWay}" AutomationProperties.Name="Share anonymous shader hashes">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Share anonymous shader hashes" TextWrapping="Wrap" />
                                    <TextBlock Text="Share your recorded hashes, GPU model and driver version. Never linked to your account." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <HyperlinkButton Content="What's shared" NavigateUri="https://scskiller.com/privacy" Padding="0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Compile speed when you run the queue" Style="{StaticResource Section}" />
                            <StackPanel Spacing="4" Visibility="{x:Bind Vm.HasGpuChoices}">
                                <ComboBox Header="GPU to compile for" ItemsSource="{x:Bind Vm.GpuLabels}" SelectedIndex="{x:Bind Vm.GpuIndex, Mode=TwoWay}"
                                          MinWidth="220" AutomationProperties.Name="GPU to compile for" />
                                <TextBlock Text="Pick the GPU your games run on. SCSKiller switches to it after a restart."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox IsChecked="{x:Bind Vm.ExperimentalIntel, Mode=TwoWay}" Visibility="{x:Bind Vm.HasIntelGpu}"
                                      AutomationProperties.Name="Experimental: compile on Intel GPUs">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Experimental: compile on Intel GPUs" TextWrapping="Wrap" />
                                    <TextBlock Text="Only measured on Intel Arc. Applies after a restart." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <Grid>
                                <TextBlock Text="Compile threads" />
                                <TextBlock Text="{x:Bind Vm.ThreadsText, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="1" Maximum="{x:Bind Vm.MaxThreads}" StepFrequency="1" Value="{x:Bind Vm.Threads, Mode=TwoWay}"
                                    AutomationProperties.Name="Compile threads" />
                            <TextBlock Text="{x:Bind Vm.PriorityNote, Mode=OneWay}" Style="{StaticResource Caption}" />
                            <Grid>
                                <TextBlock Text="Maximum memory for compiling" />
                                <TextBlock Text="{x:Bind Vm.MaxCompileMemoryText, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="{x:Bind Vm.MaxCompileMemoryMax}" StepFrequency="1" Value="{x:Bind Vm.MaxCompileMemory, Mode=TwoWay}"
                                    AutomationProperties.Name="Maximum memory for compiling (0 = Auto)" />
                            <TextBlock Text="{x:Bind Vm.MaxCompileMemoryNote}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <CheckBox IsChecked="{x:Bind Vm.MaximumPlans, Mode=TwoWay}" AutomationProperties.Name="Maximum mode: also compile every shader pairing">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Maximum mode: also compile every shader pairing" TextWrapping="Wrap" />
                                    <TextBlock Text="Seems to help most on AMD. Compiles take longer and use more disk space."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{x:Bind Vm.CompileRayTracing, Mode=TwoWay}" AutomationProperties.Name="Compile ray tracing shaders">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Compile ray tracing shaders" TextWrapping="Wrap" />
                                    <TextBlock Text="Off: skipped, the game builds them when you turn ray tracing on in it."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="General" Style="{StaticResource Section}" />
                        <CheckBox IsChecked="{x:Bind Vm.StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Start SCSKiller when Windows starts">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Start SCSKiller when Windows starts" TextWrapping="Wrap" />
                                <TextBlock Text="It waits in the notification area, next to the clock, to offer a rebuild after a driver update."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.CloseQuits, Mode=TwoWay}" AutomationProperties.Name="Closing the window quits SCSKiller">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Closing the window quits SCSKiller" TextWrapping="Wrap" />
                                <TextBlock Text="A running compile finishes saving first, like Quit in the notification area. Off: closing the window keeps SCSKiller in the tray. Right-click its icon to quit."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.BeforeAfter, Mode=TwoWay}" AutomationProperties.Name="Before and after recording">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Before and after recording" TextWrapping="Wrap" />
                                <TextBlock Text="Measure a game cold, compile it, measure it again, and get a report you can share."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.ScanAtStart, Mode=TwoWay}" AutomationProperties.Name="Scan games when SCSKiller starts">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Scan games when SCSKiller starts" TextWrapping="Wrap" />
                                <TextBlock Text="Reads again what changed in each game's folders. Off: the last list shows, and a game is read again when you refresh, when it exits, or when Steam or the Xbox app updates it."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.HddMode, Mode=TwoWay}" AutomationProperties.Name="HDD mode">
                            <StackPanel Spacing="2">
                                <TextBlock Text="HDD mode" TextWrapping="Wrap" />
                                <TextBlock Text="Reads a game's files only when you open or compile it."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind Vm.ActiveCheck, Mode=TwoWay}" AutomationProperties.Name="Send an anonymous daily check">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Send an anonymous daily check" TextWrapping="Wrap" />
                                <TextBlock Text="Helps us count active installs so we can size our servers. Once a day, the app's version and GPU vendor, no identifier."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <ComboBox Header="Theme" ItemsSource="{x:Bind local:SettingsVm.Themes}" SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}" MinWidth="220"
                                  AutomationProperties.Name="Theme" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Record in all compatible games" Style="{StaticResource Section}" />
                                <TextBlock Text="Adds a small d3d12.dll or d3d11.dll to games without anti-cheat to catch shaders the plan missed and time each frame, so the game page shows what stuttered. Frame times stay on this PC. Never used in games with anti-cheat unless you allow it below. Switch off to remove it from every game you haven't turned it on for yourself."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent="" IsOn="{x:Bind Vm.RecordAllGames, Mode=TwoWay}"
                                          AutomationProperties.Name="Record in all compatible games" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.RecordingCount, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <CheckBox IsChecked="{x:Bind Vm.RecordAntiCheatGames, Mode=TwoWay}" AutomationProperties.Name="Allow the recorder in games with anti-cheat (at your own risk)">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Allow the recorder in games with anti-cheat (at your own risk)" TextWrapping="Wrap" />
                                    <TextBlock Text="Some games contain anti-cheat that can ban accounts using the recorder. Turn this on to enable it per game, at your own risk. SCSKiller isn't responsible for bans."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <HyperlinkButton Content="Details" Click="OnAntiCheatDetails" Padding="0" Margin="28,0,0,0" AutomationProperties.Name="Details on recording in games with anti-cheat" />
                        </StackPanel>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,6" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RecordingLimitLabel" Text="Recording limit per game" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:SettingsVm.RecordingLimitLabels}" MinWidth="140"
                                      SelectedIndex="{x:Bind Vm.RecordingLimitIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{x:Bind RecordingLimitLabel}" />
                        </Grid>
                        <TextBlock Text="Counts the recording in the game's folder and SCSKiller's copy of it. At the limit the game plays as usual: new pipelines just aren't recorded."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Vm.RecordingSpace, Mode=OneWay}" TextWrapping="Wrap" />
                        <Expander Header="Space by game" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind Vm.HasRecordings, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind Vm.Recordings, Mode=OneWay}">
                                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:DetailRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind HasNote}" Foreground="{ThemeResource WarnBrush}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
