<Page
    x:Class="SCSKiller.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SCSKiller.App.Pages">

    <ScrollViewer>
        <StackPanel Padding="36,28,36,28" Spacing="16">
            <TextBlock x:Name="PageTitle" Text="About" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource Card}" Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE945;" FontSize="36" VerticalAlignment="Top" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="SCSKiller" Style="{StaticResource Section}" FontSize="20" />
                        <TextBlock x:Name="AppSubtitleText" Text="Shader Compilation Stutter Killer" Style="{StaticResource Secondary}" />
                        <TextBlock Text="{x:Bind Vm.Version}" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" Visibility="{x:Bind Vm.ShowsCheck}">
                            <Button x:Name="BtnCheckUpdates" Content="Check for updates" Click="OnCheckForUpdates" IsEnabled="{x:Bind Vm.CanCheck, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Vm.UpdateNote, Mode=OneWay}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="CheckAutoUpdates" IsChecked="{x:Bind Vm.InstallUpdatesAutomatically, Mode=TwoWay}" Visibility="{x:Bind Vm.ShowsCheck}"
                                  AutomationProperties.Name="Install updates automatically">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="AutoUpdatesTitle" Text="Install updates automatically" TextWrapping="Wrap" />
                                <TextBlock x:Name="AutoUpdatesNote" Text="A downloaded update installs the next time SCSKiller starts or quits, never during a compile, an offline session or a game. Off: only Restart to update installs it."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <InfoBar IsOpen="{x:Bind Vm.HasUpdateProblem, Mode=OneWay}" Visibility="{x:Bind Vm.HasUpdateProblem, Mode=OneWay}"
                                 Message="{x:Bind Vm.UpdateProblem, Mode=OneWay}" Severity="Warning" IsClosable="False" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" Visibility="{x:Bind Vm.ShowsSource}">
                            <Button x:Name="BtnDownloadSource" Content="Download source code" Click="OnSource" IsEnabled="{x:Bind Vm.SourceIdle, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Vm.SourceStatus, Mode=OneWay}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <TextBlock x:Name="DescriptionText" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Compiles your games' shaders into the graphics driver's cache ahead of time, so they don't stutter the first time you play them." />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Secondary}">
                            <Run x:Name="LicenseLabel" Text="SCSKiller licence:" FontWeight="SemiBold" /><Run x:Name="LicenseText" Text=" GPL-3.0-or-later, with an additional permission for Oodle, the Windows App SDK and graphics driver libraries (LICENSE-EXCEPTION.txt)" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <HyperlinkButton x:Name="LnkWebsite" Content="Website" Padding="0" FontSize="12" NavigateUri="https://scskiller.com" />
                            <HyperlinkButton x:Name="LnkSource" Content="Source code" Padding="0" FontSize="12" NavigateUri="https://github.com/BlueHeisenberg/SCSKiller" />
                            <HyperlinkButton x:Name="LnkPatreon" Content="Support on Patreon" Padding="0" FontSize="12" NavigateUri="https://www.patreon.com/SCSKiller" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock x:Name="RiskTitle" Text="Use at your own risk" Style="{StaticResource Section}" />
                <TextBlock x:Name="RiskText" Text="SCSKiller is provided as is, without warranty. It checks each game for anti-cheat before adding its recorder, but that check can miss one. You use it at your own risk, and its authors are not responsible for bans, crashes or lost data."
                           Style="{StaticResource Secondary}" TextWrapping="Wrap" />
            </StackPanel>

            <Expander x:Name="TrademarksBox" Header="Trademarks" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <TextBlock Text="{x:Bind Vm.Trademarks}" Style="{StaticResource Secondary}" TextWrapping="Wrap" LineHeight="22" IsTextSelectionEnabled="True" />
            </Expander>

            <StackPanel Spacing="8">
                <TextBlock x:Name="ThirdPartyTitle" Text="Third-party components" Style="{StaticResource Section}" />
                <TextBlock x:Name="ThirdPartyNote" Text="Open one to read its licence. The same list, with notes, is in THIRD-PARTY-NOTICES.md next to the app."
                           Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                <ItemsControl x:Name="Components" ItemsSource="{x:Bind Vm.Components}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:Notice">
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnSpacing="12" Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Header}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind LicenceName}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Secondary}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Project}" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Note}" Style="{StaticResource Secondary}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind HasNote}" />
                                    <TextBlock Text="{x:Bind Body}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>