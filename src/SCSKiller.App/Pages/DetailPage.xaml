<Page
    x:Class="SCSKiller.App.Pages.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SCSKiller.App">

    <Page.Resources>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- a label and its value on one line; the label wraps, the value keeps its width -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <DataTemplate x:Key="SourceRow" x:DataType="local:DetailRow">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind HasNote}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DetailRow" x:DataType="local:DetailRow">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource RowLabel}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource RowValue}" MaxWidth="320" />
            </Grid>
        </DataTemplate>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="36,24,36,28" Spacing="16">
            <BreadcrumbBar x:Name="Crumbs" ItemClicked="OnCrumb" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Rename…" Click="OnRename" Visibility="{x:Bind Vm.IsManual, Mode=OneWay}"
                            ToolTipService.ToolTip="The name SCSKiller shows for this game" />
                    <Button Content="Game folder…" Click="OnGameFolder" Visibility="{x:Bind Vm.IsManual, Mode=OneWay}"
                            ToolTipService.ToolTip="The folder SCSKiller checks for anti-cheat before it records this game" />
                    <Button Content="Remove from library" Click="OnRemoveGame" ToolTipService.ToolTip="{x:Bind Vm.RemoveTip, Mode=OneWay}" />
                    <Grid Background="Transparent" ToolTipService.ToolTip="{x:Bind Vm.PlayTip, Mode=OneWay}" Visibility="{x:Bind Vm.ShowPlay, Mode=OneWay}">
                        <Button Content="{x:Bind Vm.PlayText, Mode=OneWay}" Click="{x:Bind Vm.Play}" IsEnabled="{x:Bind Vm.CanPlay, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
                <Grid Width="56" Height="56" VerticalAlignment="Center">
                    <Border CornerRadius="10" Background="{x:Bind Vm.Row.Tile, Mode=OneWay}" Visibility="{x:Bind Vm.Row.NoIcon, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Vm.Row.Initials, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{x:Bind Vm.Row.Icon, Mode=OneWay}" Width="56" Height="56" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Vm.Name, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Vm.Sub, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    <TextBlock Text="● Playing now" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Visibility="{x:Bind Vm.Playing, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!-- status: the game's state and why; under it every action on one row, right-aligned (wrapping only on a narrow
                 window), then the before and after recording's note on its own line -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Vm.StatusGlyph, Mode=OneWay}" Style="{x:Bind Vm.Row.StatusStyle, Mode=OneWay}"
                               FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="24" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Vm.StatusTitle, Mode=OneWay}" Style="{x:Bind Vm.Row.StatusStyle, Mode=OneWay}" FontSize="20" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Vm.StatusReason, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Vm.GuessNote, Mode=OneWay}" Visibility="{x:Bind Vm.HasGuessNote, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Vm.HasKeptCache, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Vm.KeptCacheNote, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Clear it" Padding="0" Click="OnClearCache" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Spacing="2" Margin="0,4,0,0" Visibility="{x:Bind Vm.HasMaximumLine, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Vm.MaximumLine, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Vm.MaximumNote, Mode=OneWay}" Visibility="{x:Bind Vm.HasMaximumNote, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <HyperlinkButton Content="{x:Bind Vm.MaximumAction, Mode=OneWay}" Padding="0" Click="OnGameMaximum" IsEnabled="{x:Bind Vm.CanSetMaximum, Mode=OneWay}" />
                        </StackPanel>
                        <ProgressBar Margin="0,6,0,0" Value="{x:Bind Vm.Percent, Mode=OneWay}" IsIndeterminate="{x:Bind Vm.Indeterminate, Mode=OneWay}"
                                     Visibility="{x:Bind Vm.IsCompiling, Mode=OneWay}" AutomationProperties.Name="Compile progress" />
                    </StackPanel>
                    <local:WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8" LineAlignment="Right">
                        <Button Content="Why?" Click="OnPartlyWhy" Visibility="{x:Bind Vm.IsPartlyCompiled, Mode=OneWay}" />
                        <Button Content="Set AES key" Click="OnSetAesKey" Visibility="{x:Bind Vm.NeedsAesKey, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="{x:Bind Vm.RefreshGame}" IsEnabled="{x:Bind Vm.CanRefresh, Mode=OneWay}" AutomationProperties.Name="Refresh"
                                ToolTipService.ToolTip="Re-read this game's cache size, recording and last session" VerticalAlignment="Stretch">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <!-- tooltip on a hit-testable wrapper: a disabled button shows none -->
                        <Grid Background="Transparent" ToolTipService.ToolTip="{x:Bind Vm.ReportTip, Mode=OneWay}">
                            <Button Content="Rate this compile" Click="OnSendReport" IsEnabled="{x:Bind Vm.CanReport, Mode=OneWay}" />
                        </Grid>
                        <Button Content="Report a problem" Click="OnReportProblem" ToolTipService.ToolTip="Send the SCSKiller team what went wrong with this game" />
                        <Grid Background="Transparent" ToolTipService.ToolTip="{x:Bind Vm.ClearCacheTip, Mode=OneWay}" Visibility="{x:Bind Vm.ShowClearCache, Mode=OneWay}">
                            <Button Content="{x:Bind Vm.ClearCacheText, Mode=OneWay}" Click="OnClearCache" IsEnabled="{x:Bind Vm.CanClearCache, Mode=OneWay}" />
                        </Grid>
                        <Button Content="Max compile" Click="OnMaxCompile" Visibility="{x:Bind Vm.CanCompile, Mode=OneWay}" IsEnabled="{x:Bind Vm.CanAdd, Mode=OneWay}"
                                ToolTipService.ToolTip="Compiles every combination of this game's shaders, once" />
                        <Grid Background="Transparent" ToolTipService.ToolTip="{x:Bind Vm.CompileTip, Mode=OneWay}" Visibility="{x:Bind Vm.CanCompile, Mode=OneWay}">
                            <Button Style="{x:Bind Vm.CompileStyle, Mode=OneWay}" Click="OnCompile" IsEnabled="{x:Bind Vm.CanAdd, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE945;" FontSize="14" />
                                    <TextBlock Text="{x:Bind Vm.AddText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- before and after recording: its button, then the actions of its stage -->
                        <Grid Background="Transparent" ToolTipService.ToolTip="{x:Bind Vm.BaTip, Mode=OneWay}" Visibility="{x:Bind Vm.ShowBa, Mode=OneWay}">
                            <Button Content="{x:Bind Vm.BaText, Mode=OneWay}" Style="{x:Bind Vm.BaStyle, Mode=OneWay}" IsEnabled="{x:Bind Vm.BaEnabled, Mode=OneWay}" Click="OnBeforeAfter"
                                    AutomationProperties.HelpText="{x:Bind Vm.BaTip, Mode=OneWay}" />
                        </Grid>
                        <Button Content="Compile again" Click="OnBaCompileAgain" Visibility="{x:Bind Vm.BaCompileAgain, Mode=OneWay}" />
                        <Button Content="Record the after run again" Click="OnBaRecordAgain" Visibility="{x:Bind Vm.BaDone, Mode=OneWay}" />
                        <Button Content="Start over" Click="OnBaStartOver" Visibility="{x:Bind Vm.BaDone, Mode=OneWay}" />
                        <Button Content="How it works" Click="OnBaHowItWorks" Visibility="{x:Bind Vm.BaHasMenu, Mode=OneWay}" />
                        <Button Content="Cancel the before and after recording" Click="OnBaCancel" Visibility="{x:Bind Vm.BaInProgress, Mode=OneWay}" />
                    </local:WrapPanel>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind Vm.BaNote, Mode=OneWay}" Visibility="{x:Bind Vm.HasBaNote, Mode=OneWay}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Right" />
                </Grid>
            </Border>

            <!-- stutters without a compile: a slim full-width strip under the status, the reason and its source inline -->
            <Border Style="{StaticResource Card}" Padding="20,10" Visibility="{x:Bind Vm.IsKnownStutter, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                        <Run Text="Stutters without a compile" Foreground="{ThemeResource WarnBrush}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{x:Bind Vm.StutterReason, Mode=OneWay}" /><Run Text="  " /><Run Text="{x:Bind Vm.StutterCitation, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Hyperlink NavigateUri="{x:Bind Vm.StutterUri, Mode=OneWay}"><Run Text="{x:Bind Vm.StutterLinkText, Mode=OneWay}" /></Hyperlink>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,10" Visibility="{x:Bind Vm.IsNoStutter, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                        <Run Text="No shader stutter" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{x:Bind Vm.NoStutterReason, Mode=OneWay}" /><Run Text=". Compiling it isn't needed." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                </Grid>
            </Border>

            <!-- what players with a similar system reported (the public compat aggregate) -->
            <Border Style="{StaticResource Card}" Padding="20,10" Visibility="{x:Bind Vm.HasSimilar, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE716;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Vm.SimilarText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20,10" Visibility="{x:Bind Vm.HasSimilarWarning, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Vm.SimilarText, Mode=OneWay}" Foreground="{ThemeResource WarnBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- tags: wrap to new lines instead of clipping -->
            <local:WrapPanel Spacing="8">
                <Border Style="{StaticResource Chip}">
                    <TextBlock Text="{x:Bind Vm.EngineChip, Mode=OneWay}" Style="{StaticResource ChipText}" />
                </Border>
                <Border Style="{StaticResource Chip}" Visibility="{x:Bind Vm.HasApi, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Vm.ApiChip, Mode=OneWay}" Style="{StaticResource ChipText}" />
                </Border>
                <ComboBox ItemsSource="{x:Bind Vm.ApiItems, Mode=OneWay}" SelectedIndex="{x:Bind Vm.ApiIndex, Mode=OneWay}" SelectionChanged="OnApiPicked"
                          Visibility="{x:Bind Vm.ShowApiPicker, Mode=OneWay}" IsEnabled="{x:Bind Vm.CanPickApi, Mode=OneWay}" FontSize="12" MinHeight="0" Padding="10,2,0,3"
                          AutomationProperties.Name="DirectX" ToolTipService.ToolTip="The DirectX SCSKiller compiles for. Auto uses the detected one." />
                <Border Style="{StaticResource Chip}" Visibility="{x:Bind Vm.HasMiddleware, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Vm.MiddlewareTip, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Vm.MiddlewareChip, Mode=OneWay}" Style="{StaticResource ChipText}" />
                </Border>
                <Border Style="{StaticResource Chip}" Visibility="{x:Bind Vm.HasModChip, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Vm.ModTip, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Vm.ModChip, Mode=OneWay}" Style="{StaticResource ChipText}" />
                </Border>
                <Border Style="{StaticResource Chip}" ToolTipService.ToolTip="{x:Bind Vm.AntiCheatTip, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Vm.AntiCheatChip, Mode=OneWay}" Style="{StaticResource ChipText}" />
                </Border>
            </local:WrapPanel>
            <TextBlock Text="{x:Bind Vm.ApiOverruled, Mode=OneWay}" Visibility="{x:Bind Vm.HasApiOverruled, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,-8,0,0" />

            <InfoBar Severity="Error" IsOpen="{x:Bind Vm.HasError, Mode=OneWay}" Visibility="{x:Bind Vm.HasError, Mode=OneWay}" Message="{x:Bind Vm.Error, Mode=OneWay}" IsClosable="False" />

            <!-- a game that needs a recording before it can compile -->
            <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind Vm.HasRecordTip, Mode=OneWay}" Visibility="{x:Bind Vm.HasRecordTip, Mode=OneWay}"
                     Title="{x:Bind Vm.RecordTipTitle, Mode=OneWay}" Message="{x:Bind Vm.RecordTip, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Turn on recording" Click="OnRecordTip" HorizontalAlignment="Right" Visibility="{x:Bind Vm.ShowRecordAction, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock TextWrapping="Wrap" Margin="4,0" Visibility="{x:Bind Vm.HasDbTeaser, Mode=OneWay}">
                <Run Text="{x:Bind Vm.DbTeaser, Mode=OneWay}" /><Run Text=" " /><Hyperlink Click="OnDbTeaser"><Run Text="{x:Bind Vm.DbTeaserLink, Mode=OneWay}" /></Hyperlink>
            </TextBlock>

            <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind Vm.ShowLeftCallout, Mode=OneWay}" Visibility="{x:Bind Vm.ShowLeftCallout, Mode=OneWay}"
                     Title="{x:Bind Vm.LeftTitle, Mode=OneWay}" Message="{x:Bind Vm.LeftText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Turn on recording" Click="OnRecordTip" HorizontalAlignment="Right" Visibility="{x:Bind Vm.ShowRecordAction, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource Card}" Padding="20,18" Visibility="{x:Bind Vm.HasCoverageCard, Mode=OneWay}">
                <StackPanel Spacing="20">
                    <TextBlock Text="Shader coverage" Style="{StaticResource Section}" />
                    <Grid ColumnSpacing="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid Width="120" Height="120" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Vm.CoverageHeadline, Mode=OneWay}">
                            <Ellipse Stroke="{ThemeResource ControlStrongFillColorDisabledBrush}" StrokeThickness="12" />
                            <Path Data="{x:Bind Vm.GoodArc, Mode=OneWay}" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="12"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="{x:Bind Vm.LowArc, Mode=OneWay}" Stroke="{ThemeResource WarnBrush}" StrokeThickness="12"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind Vm.CoverageValue, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind Vm.CoverageLabel, Mode=OneWay}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <!-- the stats, and where the shaders come from beside them (under them on a narrow window) -->
                        <local:WrapPanel Grid.Column="1" Spacing="28" VerticalAlignment="Center">
                            <local:WrapPanel Spacing="20" MinItemWidth="170" Width="380">
                                <StackPanel Spacing="2" Visibility="{x:Bind Vm.HasTimeValue, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Vm.TimeLabel, Mode=OneWay}" Style="{StaticResource Secondary}" />
                                    <TextBlock Text="{x:Bind Vm.TimeValue, Mode=OneWay}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel Spacing="2" Visibility="{x:Bind Vm.HasDiskValue, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Vm.DiskLabel, Mode=OneWay}" Style="{StaticResource Secondary}" />
                                    <TextBlock Text="{x:Bind Vm.DiskValue, Mode=OneWay}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel Spacing="2" Visibility="{x:Bind Vm.HasStutterTile, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Vm.StuttersLabel, Mode=OneWay}" Style="{StaticResource Secondary}" />
                                    <TextBlock Text="{x:Bind Vm.StuttersValue, Mode=OneWay}" Style="{StaticResource StatValue}" Visibility="{x:Bind Vm.NoStutters, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Vm.StuttersValue, Mode=OneWay}" Style="{StaticResource StatValue}" Foreground="{ThemeResource WarnBrush}" Visibility="{x:Bind Vm.HasStutters, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Spacing="2" Visibility="{x:Bind Vm.HasShaderCount, Mode=OneWay}">
                                    <TextBlock Text="Shaders in the game" Style="{StaticResource Secondary}" />
                                    <TextBlock Text="{x:Bind Vm.ShaderCount, Mode=OneWay}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </local:WrapPanel>
                            <StackPanel Spacing="6" Width="320" Visibility="{x:Bind Vm.HasSources, Mode=OneWay}">
                                <TextBlock Text="Where the shaders come from" Style="{StaticResource Secondary}" />
                                <ItemsRepeater ItemsSource="{x:Bind Vm.Sources, Mode=OneWay}" ItemTemplate="{StaticResource SourceRow}">
                                    <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </local:WrapPanel>
                    </Grid>

                    <Expander x:Name="DetailsExpander" Header="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Details, Mode=OneWay}" ItemTemplate="{StaticResource DetailRow}">
                            <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- frame times of the last session, full width: the graph gets the room -->
            <Border x:Name="FramesCard" Style="{StaticResource Card}" Padding="20,18" Visibility="{x:Bind Vm.HasFramesCard, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2" Visibility="{x:Bind Vm.HasFrames, Mode=OneWay}">
                        <TextBlock Text="Frame times last time you played" Style="{StaticResource Section}" />
                        <TextBlock Text="{x:Bind Vm.FramesVerdict, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind Vm.HasFrames, Mode=OneWay}">
                        <local:FrameGraph x:Name="Graph" Height="140" AutomationProperties.Name="{x:Bind Vm.FramesVerdict, Mode=OneWay}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="shader compile" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="other hitch" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Rectangle Width="10" Height="8" Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" Opacity="0.45" VerticalAlignment="Center" />
                                    <TextBlock Text="loading, quitting" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Rectangle Width="10" Height="8" Fill="{ThemeResource WarnBrush}" Opacity="0.3" VerticalAlignment="Center" />
                                    <TextBlock Text="loading, compiling shaders" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Vm.GraphEnd, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </StackPanel>
                    <Expander x:Name="EarlierExpander" Header="Earlier sessions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Visibility="{x:Bind Vm.HasEarlierSessions, Mode=OneWay}">
                        <ItemsRepeater ItemsSource="{x:Bind Vm.EarlierSessions, Mode=OneWay}" ItemTemplate="{StaticResource DetailRow}" MaxWidth="620" HorizontalAlignment="Left">
                            <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Expander>
                    <Expander x:Name="SlowFramesExpander" Header="Slow frames" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Visibility="{x:Bind Vm.HasFrames, Mode=OneWay}">
                        <StackPanel Spacing="8" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind Vm.FramesSummary, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                            <ItemsRepeater ItemsSource="{x:Bind Vm.HitchRows, Mode=OneWay}" ItemTemplate="{StaticResource DetailRow}" Visibility="{x:Bind Vm.HasHitchRows, Mode=OneWay}">
                                <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- last compile and recording: side by side, stacked on a narrow window -->
            <local:WrapPanel Spacing="12" MinItemWidth="340">
                <Border Style="{StaticResource Card}" Padding="20,18" Visibility="{x:Bind Vm.HasCompileCard, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Vm.CompileTitle, Mode=OneWay}" Style="{StaticResource Section}" />
                            <TextBlock Text="{x:Bind Vm.CompileText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind Vm.HasSkipped, Mode=OneWay}" Visibility="{x:Bind Vm.HasSkipped, Mode=OneWay}"
                                 Title="{x:Bind Vm.SkippedTitle, Mode=OneWay}" Message="{x:Bind Vm.SkippedText, Mode=OneWay}" />
                        <Grid ColumnSpacing="12" Visibility="{x:Bind Vm.HasCareful, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Careful compile" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Vm.CarefulNote, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CarefulSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent=""
                                          IsOn="{x:Bind Vm.CarefulOn, Mode=OneWay}" IsEnabled="{x:Bind Vm.CanToggleCareful, Mode=OneWay}" Toggled="OnCarefulToggled"
                                          AutomationProperties.Name="Careful compile" AutomationProperties.HelpText="{x:Bind Vm.CarefulNote, Mode=OneWay}" />
                        </Grid>
                        <StackPanel x:Name="KeptPanel" Spacing="2" Visibility="{x:Bind Vm.HasKept, Mode=OneWay}">
                            <TextBlock Text="Kept aside" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Vm.KeptSize, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Vm.KeptState, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="When this game has new shaders" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox x:Name="NewShadersBox" ItemsSource="{x:Bind Vm.NewShadersChoices, Mode=OneWay}" SelectedIndex="{x:Bind Vm.NewShadersIndex, Mode=OneWay}"
                                      SelectionChanged="OnNewShadersChanged" AutomationProperties.Name="When this game has new shaders" />
                        </StackPanel>
                        <StackPanel Spacing="4" Visibility="{x:Bind Vm.ShowRayTracing, Mode=OneWay}">
                            <TextBlock Text="Ray tracing shaders" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox x:Name="RayTracingBox" ItemsSource="{x:Bind Vm.RayTracingChoices, Mode=OneWay}" SelectedIndex="{x:Bind Vm.RayTracingIndex, Mode=OneWay}"
                                      SelectionChanged="OnRayTracingChanged" AutomationProperties.Name="Ray tracing shaders" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Leave out of Add all ready" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="LeftOutSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent=""
                                          IsOn="{x:Bind Vm.LeftOutOn, Mode=OneWay}" Toggled="OnLeftOutToggled" AutomationProperties.Name="Leave out of Add all ready" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Record while I play" Style="{StaticResource Section}" />
                                <TextBlock Text="{x:Bind Vm.RecordNote, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                <HyperlinkButton Content="{x:Bind Vm.UseDefaultText, Mode=OneWay}" Click="OnUseDefault" Padding="0" Margin="0,2,0,0"
                                                 Visibility="{x:Bind Vm.ShowUseDefault, Mode=OneWay}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RecordSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent=""
                                          IsOn="{x:Bind Vm.RecordOn, Mode=OneWay}" IsEnabled="{x:Bind Vm.CanToggleRecord, Mode=OneWay}" Toggled="OnRecordToggled"
                                          AutomationProperties.Name="Record while I play" AutomationProperties.HelpText="{x:Bind Vm.RecordNote, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Spacing="14" Visibility="{x:Bind Vm.ShowOfflineOn, Mode=OneWay}">
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Error" Title="Ban risk" Message="{x:Bind Vm.OfflineRiskText, Mode=OneWay}" />
                            <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind Vm.HasSessionNote, Mode=OneWay}" Visibility="{x:Bind Vm.HasSessionNote, Mode=OneWay}"
                                     Message="{x:Bind Vm.SessionNote, Mode=OneWay}" />
                            <Button HorizontalAlignment="Right" Content="{x:Bind Vm.OfflineButtonText, Mode=OneWay}" Click="OnRecordOffline" IsEnabled="{x:Bind Vm.CanStartOffline, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Vm.OfflineButtonText, Mode=OneWay}" />
                        </StackPanel>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind Vm.HasMod, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Vm.AlongsideTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Vm.AlongsideNote, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AlongsideSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent=""
                                          IsOn="{x:Bind Vm.AlongsideOn, Mode=OneWay}" IsEnabled="{x:Bind Vm.CanToggleAlongside, Mode=OneWay}" Toggled="OnAlongsideToggled"
                                          AutomationProperties.Name="{x:Bind Vm.AlongsideTitle, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Vm.AlongsideNote, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Spacing="6" Visibility="{x:Bind Vm.HasRecording, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Vm.RecordingPausedText, Mode=OneWay}" Foreground="{ThemeResource WarnBrush}" TextWrapping="Wrap"
                                       Visibility="{x:Bind Vm.RecordingPaused, Mode=OneWay}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Vm.RecordingSize, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Clear recording" Click="OnClearRecording" IsEnabled="{x:Bind Vm.CanClearRecording, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Vm.ClearRecordingTip, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="Play with it on and your last session shows here: how much was ready and what still stuttered."
                                   Style="{StaticResource Secondary}" TextWrapping="Wrap" Visibility="{x:Bind Vm.ShowSessionHint, Mode=OneWay}" />
                        <StackPanel Spacing="10" Visibility="{x:Bind Vm.HasSession, Mode=OneWay}">
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0,0,4" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Vm.SessionHeader, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Vm.SessionVerdict, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Vm.StateObjectLine, Mode=OneWay}" Visibility="{x:Bind Vm.HasStateObjectLine, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Vm.RayQueryLine, Mode=OneWay}" Visibility="{x:Bind Vm.HasRayQueryLine, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Height="8" CornerRadius="4" Background="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                  AutomationProperties.Name="{x:Bind Vm.SessionLabel, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind Vm.LibraryWidth, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Vm.HitsWidth, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Vm.CompilesWidth, Mode=OneWay}" MinWidth="{x:Bind Vm.CompilesMinWidth, Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <Rectangle Grid.Column="1" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Rectangle Grid.Column="2" Fill="{ThemeResource WarnBrush}" />
                            </Grid>
                            <Grid RowSpacing="6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Grid.Column="1" Text="Ready in the game's own library" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Vm.FromLibrary, Mode=OneWay}" Style="{StaticResource Secondary}" />
                                <Rectangle Grid.Row="1" Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Ready in the driver cache" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind Vm.CacheHits, Mode=OneWay}" Style="{StaticResource Secondary}" />
                                <Rectangle Grid.Row="2" Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource WarnBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Compiled during play" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{x:Bind Vm.Compiles, Mode=OneWay}" Style="{StaticResource Secondary}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </local:WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
