<Page
    x:Class="SCSKiller.App.Pages.CachePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SCSKiller.App">

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="36,28,36,28" Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Cache" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Vm.Total, Mode=OneWay}" Style="{StaticResource Secondary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Content="Clear everything" Click="OnClearEverything" IsEnabled="{x:Bind Vm.CanClearEverything, Mode=OneWay}" />
                    <Button Content="Refresh" Click="OnRefresh" />
                </StackPanel>
            </Grid>

            <InfoBar IsOpen="{x:Bind Vm.HasResult, Mode=OneWay}" Visibility="{x:Bind Vm.HasResult, Mode=OneWay}" Message="{x:Bind Vm.Result, Mode=OneWay}"
                     Severity="{x:Bind Vm.ResultSeverity, Mode=OneWay}" IsClosable="False" />
            <InfoBar IsOpen="{x:Bind Vm.HasOldDriver, Mode=OneWay}" Visibility="{x:Bind Vm.HasOldDriver, Mode=OneWay}" Message="{x:Bind Vm.OldDriverText, Mode=OneWay}"
                     Severity="Informational" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="{x:Bind Vm.FreeText, Mode=OneWay}" Click="OnFreeOldDriver" IsEnabled="{x:Bind Vm.CanDelete, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Where the driver keeps its cache" Style="{StaticResource Section}" />
                    <TextBlock Text="Games read their cache from here, and new caches are written here. The driver has no setting to move it."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <TextBlock Text="SCSKiller doesn't know where this GPU's driver keeps its cache." Visibility="{x:Bind Vm.NoFolders, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Folders, Mode=OneWay}">
                        <ItemsRepeater.Layout><StackLayout Spacing="12" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:CacheFolderRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Label}" />
                                        <TextBlock Text="{x:Bind Path}" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind HasNote}" Foreground="{ThemeResource WarnBrush}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Size}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Open folder" Tag="{x:Bind Path}" Click="OnOpenFolder" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <ItemsRepeater ItemsSource="{x:Bind Vm.Groups, Mode=OneWay}">
                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:CacheGroupRow">
                        <Expander IsExpanded="{x:Bind Expanded}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource Section}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Size}" Style="{StaticResource Section}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Delete all" Tag="{x:Bind}" Click="OnDeleteGroup" IsEnabled="{x:Bind Enabled}" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind HasNote}" Foreground="{ThemeResource WarnBrush}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <ItemsRepeater ItemsSource="{x:Bind Items}">
                                    <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:CacheItemRow">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind HasNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <HyperlinkButton Grid.Column="1" Content="Open folder" Tag="{x:Bind Folder}" Click="OnOpenFolder" Padding="0"
                                                                 Visibility="{x:Bind HasFolder}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Size}" VerticalAlignment="Center" />
                                                <HyperlinkButton Grid.Column="3" Content="Delete" Tag="{x:Bind}" Click="OnDeleteItem" Padding="0"
                                                                 IsEnabled="{x:Bind Enabled}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
