<Window
    x:Class="SCSKiller.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SCSKiller">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!-- Screenshots only: RenderTargetBitmap can't capture Mica, so paint its solid fallback. -->
        <Border x:Name="ShotBackground" Grid.RowSpan="2" Visibility="Collapsed"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

        <TitleBar x:Name="AppTitleBar" Title="SCSKiller" Subtitle="Shader Compilation Stutter Killer"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="True" PaneToggleRequested="OnPaneToggle">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE945;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </TitleBar.IconSource>
            <TitleBar.Resources>
                <!-- the template's default 48 px drag column leaves a gap between the bell and the caption buttons -->
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            </TitleBar.Resources>
            <!-- a downloaded update (Updater): quiet, never a dialog -->
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="UpdateButton" Visibility="Collapsed" Click="OnRestartToUpdate" Padding="10,3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="13" />
                            <TextBlock x:Name="UpdateText" Text="Restart to update" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <!-- 46 px: the system caption-button width, so the bell sits flush against min/max/close -->
                    <Button x:Name="BellButton" Background="Transparent" BorderThickness="0" Padding="0"
                            Width="46" VerticalAlignment="Stretch"
                            ToolTipService.ToolTip="Notifications" AutomationProperties.Name="Notifications">
                        <!-- sized to hold the badge, which hangs off the glyph's top-right corner; negative margins would clip it -->
                        <Grid Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA8F;" FontSize="16" />
                            <InfoBadge x:Name="BellBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="BellFlyout" Placement="BottomEdgeAlignedRight" Opening="OnBellOpening" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- the pane opens only once the pages have the room they have at the minimum window width with it compact -->
        <NavigationView x:Name="Nav" Grid.Row="1" OpenPaneLength="248" ExpandedModeThresholdWidth="1258"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False"
                        SelectionChanged="OnNavSelection" ItemInvoked="OnNavInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LibraryItem" Content="Library">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF0E2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="QueueItem" Content="Compile queue">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CacheItem" Content="Cache">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsItem" Content="Settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutItem" Content="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneFooter>
                <Border Style="{StaticResource Card}" Margin="4,0,4,4" Padding="12,8"
                        Visibility="{x:Bind Nav.IsPaneOpen, Mode=OneWay}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="GPU" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="GpuName" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="GpuDriver" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" Navigated="OnNavigated" />
        </NavigationView>
    </Grid>
</Window>
