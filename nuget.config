<?xml version="1.0" encoding="utf-8"?>
<!-- SCSKiller.CUE4Parse comes only from build/packages/ (build/cue4parse/build.ps1), everything else only from nuget.org -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="scskiller" value="build/packages/" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="scskiller">
      <package pattern="SCSKiller.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
